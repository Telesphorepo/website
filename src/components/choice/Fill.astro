---
/*
 * One line of small text that names the placeholders in the commands below it: "The commands use
 * https://your-server and your-repo. Use your own". Click Use your own to open two inputs, "Your
 * server's address" and "Repository". As the reader types, the page puts the values in place of
 * https://your-server and your-repo: in the text, in each code line and in each copy button. With
 * values, the line names them and the button reads Change. Empty inputs keep the placeholders.
 *
 * Put it right above the first command that holds a placeholder. The values come from the address
 * (?server=&repo=), then from localStorage. Each change writes them to both, so an admin can share
 * a link that opens with the real commands. The page makes no request to the server. Without
 * JavaScript, the line stays hidden and the placeholders stay.
 */
// The code blocks come after the line, so the script waits for the whole page.
const script = `(() => {
    const run = () => {
    const root = document.getElementById('tr-fill');
    if (!root) return;
    const SERVER = 'https://your-server';
    const REPO = 'your-repo';
    const server = root.querySelector('#tr-fill-server');
    const repo = root.querySelector('#tr-fill-repo');
    const toggle = root.querySelector('.tr-fill-toggle');
    const fields = root.querySelector('.tr-fill-fields');
    const shown = { server: root.querySelector('[data-fill-show="server"]'), repo: root.querySelector('[data-fill-show="repo"]') };
    const read = (key) => { try { return localStorage.getItem('tr-fill-' + key) || ''; } catch (e) { return ''; } };
    const write = (key, value) => { try { localStorage.setItem('tr-fill-' + key, value); } catch (e) {} };
    const normalServer = (v) => {
        v = v.trim().replace(/\\/+$/, '');
        if (v && !/^[a-z][a-z0-9+.-]*:\\/\\//i.test(v)) v = 'https://' + v;
        return v;
    };

    // Each group is a list of text nodes whose joined text can hold a placeholder: one code line,
    // or one text node outside code. A placeholder can span several nodes of a highlighted line.
    const content = document.querySelector('.sl-markdown-content') || document.body;
    const groups = [];
    const has = (text) => text.includes(SERVER) || text.includes(REPO);
    // The text nodes under el, in order. A code line is one group; other text nodes are one each.
    const collect = (el, nodes) => {
        for (const child of el.childNodes) {
            if (child.nodeType === 3) {
                if (nodes) nodes.push(child);
                else if (has(child.data)) groups.push({ nodes: [child], originals: [child.data] });
            } else if (child.nodeType === 1 && child.id !== 'tr-fill') {
                if (!nodes && child.matches('.ec-line .code')) {
                    const line = collect(child, []);
                    const originals = line.map((n) => n.data);
                    if (has(originals.join(''))) groups.push({ nodes: line, originals });
                } else {
                    collect(child, nodes);
                }
            }
        }
        return nodes;
    };
    collect(content, null);
    const buttons = [...content.querySelectorAll('.expressive-code button[data-code]')]
        .map((b) => ({ b, code: b.getAttribute('data-code') }))
        .filter((x) => x.code.includes(SERVER) || x.code.includes(REPO));

    const replaceAll = (s, values) => s.split(SERVER).map((part) => part.split(REPO).join(values.repo)).join(values.server);

    const fill = (values) => {
        for (const g of groups) {
            const text = g.originals.join('');
            // The placeholder matches in order, left to right.
            const matches = [];
            const re = /https:\\/\\/your-server|your-repo/g;
            let m;
            while ((m = re.exec(text))) matches.push({ start: m.index, end: m.index + m[0].length, value: m[0] === SERVER ? values.server : values.repo });
            let offset = 0;
            g.nodes.forEach((node, i) => {
                const s = g.originals[i];
                let out = '';
                for (let p = offset; p < offset + s.length; p++) {
                    const hit = matches.find((x) => p >= x.start && p < x.end);
                    if (!hit) out += text[p];
                    else if (p === hit.start) out += hit.value;
                }
                if (node.data !== out) node.data = out;
                offset += s.length;
            });
        }
        for (const x of buttons) x.b.setAttribute('data-code', replaceAll(x.code, values));
    };

    const apply = (store) => {
        const s = normalServer(server.value);
        const r = repo.value.trim();
        fill({ server: s || SERVER, repo: r || REPO });
        shown.server.textContent = s || SERVER;
        shown.repo.textContent = r || REPO;
        toggle.textContent = s || r ? 'Change' : 'Use your own';
        if (!store) return;
        write('server', s);
        write('repo', r);
        try {
            const url = new URL(location.href);
            if (s) url.searchParams.set('server', s); else url.searchParams.delete('server');
            if (r) url.searchParams.set('repo', r); else url.searchParams.delete('repo');
            history.replaceState(history.state, '', url);
        } catch (e) {}
    };

    const params = new URLSearchParams(location.search);
    server.value = params.get('server') || read('server');
    repo.value = params.get('repo') || read('repo');
    root.addEventListener('input', () => apply(true));
    toggle.addEventListener('click', () => {
        const open = fields.hidden;
        fields.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        if (open) server.focus();
    });
    root.hidden = false;
    apply(params.has('server') || params.has('repo'));
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
})();`;
---

<div id="tr-fill" class="tr-fill not-content" hidden>
    <p class="tr-fill-line">
        The commands use <code data-fill-show="server">https://your-server</code> and <code data-fill-show="repo">your-repo</code>.{' '}
        <button type="button" class="tr-fill-toggle" aria-expanded="false" aria-controls="tr-fill-fields">Use your own</button>
    </p>
    <div class="tr-fill-fields" id="tr-fill-fields" hidden>
        <label>
            <span>Your server's address</span>
            <input id="tr-fill-server" type="url" inputmode="url" placeholder="https://repo.example.com" autocomplete="off" spellcheck="false" />
        </label>
        <label>
            <span>Repository</span>
            <input id="tr-fill-repo" type="text" placeholder="releases" autocomplete="off" spellcheck="false" />
        </label>
    </div>
</div>
<script is:inline set:html={script}></script>

<style>
    .tr-fill {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        color: var(--tr-muted);
        font-size: 0.875rem;
        line-height: 1.45;
    }

    .tr-fill[hidden],
    .tr-fill-fields[hidden] {
        display: none;
    }

    .tr-fill-line {
        margin: 0;
        max-width: var(--tr-measure);
    }

    .tr-fill-line code {
        padding: 0.1em 0.35em;
        border-radius: 4px;
        background-color: var(--tr-raised);
        color: var(--tr-body);
        font-family: var(--__sl-font-mono);
        font-size: 0.9em;
        overflow-wrap: anywhere;
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
    }

    .tr-fill-toggle {
        margin: 0;
        padding: 0;
        border: 0;
        background: none;
        color: var(--tr-link);
        font: inherit;
        font-weight: 600;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
        text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
        cursor: pointer;
    }

    .tr-fill-toggle:hover {
        color: var(--tr-heading);
        text-decoration-color: currentColor;
    }

    .tr-fill-fields {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
        gap: 0.75rem;
    }

    .tr-fill label {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        color: var(--tr-heading);
        font-weight: 500;
    }

    .tr-fill input {
        min-height: 2.75rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--tr-control);
        border-radius: 8px;
        background-color: var(--tr-surface);
        color: var(--tr-heading);
        font: inherit;
        font-size: 1rem;
        font-weight: 400;
    }

    .tr-fill input::placeholder {
        color: var(--tr-muted);
    }

    .tr-fill input:focus-visible {
        outline: 2px solid var(--tr-accent);
        outline-offset: 1px;
    }
</style>
