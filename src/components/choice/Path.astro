---
/*
 * One block of steps for one answer to the questions of Choice.astro. Every other prop becomes a
 * data-<key> attribute: <Path title="..." from="github" tool="maven"> shows only when the answer
 * to "from" is github and the answer to "tool" is maven. A value can list several answers,
 * separated by spaces. The title shows only without JavaScript, when every block is on the page.
 */
interface Props {
    title: string;
    level?: 2 | 3 | 4;
    [key: string]: string | number | undefined;
}

const { title, level = 2, ...when } = Astro.props;
const attrs = Object.fromEntries(Object.entries(when).map(([key, value]) => [`data-${key}`, value]));
// The id comes from the answers. A page can hold several blocks for the same answers (one per
// section), so a repeated id gets a number: github, github-2, github-3.
const base = Object.values(when).join('-').replace(/[^a-z0-9-]+/gi, '-').toLowerCase();
const taken: Set<string> = ((Astro.locals as { trPathIds?: Set<string> }).trPathIds ??= new Set());
let id = base;
for (let n = 2; taken.has(id); n++) id = `${base}-${n}`;
taken.add(id);
const Heading = `h${level}` as 'h2' | 'h3' | 'h4';
---

<section class="tr-path" {...attrs}>
    <Heading class="tr-path-title" id={id}>{title}</Heading>
    <slot />
</section>
