---
/*
 * One or more questions on a page, such as "Where does the job run?": a fieldset for each, with
 * one radio button for each answer, drawn as a card. A Path block (Path.astro) carries data-<key>
 * attributes and shows only when every question it names has an answer that it lists.
 *
 * The page asks first: with no answer in the address and none stored, no option is chosen, the
 * line "Choose one to see the steps." stands under the question, and every Path that names the
 * question stays hidden. Answers come from the address (?from=github), then from localStorage
 * (tr-choice-<key>), then, for a question with detect: 'os', from the browser's platform. A choice
 * stores the answer and writes it to the address, so a copied link opens the same steps.
 *
 * The script sets data-tr-<key> on <html> (empty while unanswered) before the blocks below it
 * render, and the CSS here hides the blocks that do not match, so the page does not flash.
 * Without JavaScript, the questions stay hidden and every block shows under its own title.
 */
interface Option {
    value: string;
    label: string;
    /** One line under the label, shown until the reader answers. */
    description?: string;
}

interface Question {
    key: string;
    label: string;
    options: Option[];
    /** 'os' answers the question from the browser's platform: 'windows' or 'unix'. */
    detect?: 'os';
}

interface Props {
    questions: Question[];
}

const { questions } = Astro.props;

// Radio groups need a name that is unique on the page, also when two blocks ask the same question.
const locals = Astro.locals as { trChoiceCount?: number };
const instance = (locals.trChoiceCount = (locals.trChoiceCount ?? 0) + 1);

const data = JSON.stringify(questions.map((q) => ({ key: q.key, values: q.options.map((o) => o.value), detect: q.detect })));

// Hide each block that names a question while it has no answer, and each block that does not list
// the answer.
const css = [
    ...questions.map((q) => `html[data-tr-${q.key}=""] [data-${q.key}]{display:none}`),
    ...questions.flatMap((q) => q.options.map((o) =>
        `html[data-tr-${q.key}="${o.value}"] [data-${q.key}]:not([data-${q.key}~="${o.value}"]){display:none}`)),
    'html[data-tr-choice] .tr-path-title{display:none}',
].join('\n');

// The script sits right after its block, so it finds the block as its previous sibling.
const script = `(() => {
    const root = document.currentScript && document.currentScript.previousElementSibling;
    if (!root || !root.dataset.choice) return;
    const questions = JSON.parse(root.dataset.choice);
    const html = document.documentElement;
    const params = new URLSearchParams(location.search);
    const read = (key) => { try { return localStorage.getItem('tr-choice-' + key); } catch (e) { return null; } };
    const write = (key, value) => { try { localStorage.setItem('tr-choice-' + key, value); } catch (e) {} };
    const platform = () => {
        const p = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || navigator.userAgent;
        return /win/i.test(p) ? 'windows' : 'unix';
    };
    const state = {};
    for (const q of questions) {
        const fromUrl = params.get(q.key);
        const stored = read(q.key);
        if (fromUrl && q.values.includes(fromUrl)) {
            state[q.key] = fromUrl;
            write(q.key, fromUrl);
        } else if (stored && q.values.includes(stored)) {
            state[q.key] = stored;
        } else if (q.detect === 'os' && q.values.includes(platform())) {
            state[q.key] = platform();
        } else {
            state[q.key] = '';
        }
    }
    const fieldsets = [...root.querySelectorAll('fieldset[data-key]')];
    const apply = () => {
        html.setAttribute('data-tr-choice', '');
        for (const q of questions) html.setAttribute('data-tr-' + q.key, state[q.key]);
        for (const set of fieldsets) {
            const value = state[set.dataset.key];
            set.toggleAttribute('data-answered', Boolean(value));
            for (const input of set.querySelectorAll('input')) input.checked = input.value === value;
        }
        try {
            const url = new URL(location.href);
            for (const q of questions) if (state[q.key]) url.searchParams.set(q.key, state[q.key]);
            history.replaceState(history.state, '', url);
        } catch (e) {}
    };
    root.addEventListener('change', (e) => {
        const input = e.target;
        const set = input.closest('fieldset[data-key]');
        if (!set || !input.checked) return;
        state[set.dataset.key] = input.value;
        write(set.dataset.key, input.value);
        apply();
    });
    root.hidden = false;
    apply();
})();`;
---

<div class="tr-choice not-content" data-choice={data} hidden>
    {questions.map((q) => (
        <fieldset class="tr-question" data-key={q.key}>
            <legend class="tr-question-label">{q.label}</legend>
            <p class="tr-question-hint">Choose one to see the steps.</p>
            <div class="tr-options">
                {q.options.map((o) => (
                    <label class="tr-option">
                        <input type="radio" name={`tr-choice-${instance}-${q.key}`} value={o.value} />
                        <span class="tr-option-mark" aria-hidden="true"></span>
                        <span class="tr-option-text">
                            <span class="tr-option-label">{o.label}</span>
                            {o.description && <span class="tr-option-description">{o.description}</span>}
                        </span>
                    </label>
                ))}
            </div>
        </fieldset>
    ))}
</div>
<script is:inline set:html={script}></script>
<style is:inline set:html={css}></style>

<style>
    .tr-choice {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        margin-block: 2rem;
    }

    .tr-choice[hidden] {
        display: none;
    }

    .tr-question {
        min-width: 0;
        margin: 0;
        padding: 0;
        border: 0;
    }

    .tr-question-label {
        padding: 0;
        color: var(--tr-heading);
        font-size: 1.125rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.35;
    }

    .tr-question-hint {
        margin: 0.25rem 0 0;
        color: var(--tr-muted);
        font-size: 0.875rem;
        line-height: 1.45;
    }

    .tr-question[data-answered] .tr-question-hint {
        display: none;
    }

    .tr-options {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr));
        gap: 0.5rem;
        margin-top: 0.75rem;
    }

    /* Before the answer, a phone gives each option a row of its own, so its description has room. */
    @media (max-width: 49.99rem) {
        .tr-question:not([data-answered]) .tr-options {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .tr-option {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        min-height: 3rem;
        padding: 0.75rem 1rem;
        border: 1px solid var(--tr-control);
        border-radius: 10px;
        background-color: var(--tr-surface);
        cursor: pointer;
        transition: border-color 120ms ease, background-color 120ms ease;
    }

    .tr-option:hover {
        border-color: var(--tr-muted);
    }

    /* The radio stays in the page for the keyboard and screen readers; the card draws it. */
    .tr-option input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        margin: 0;
        opacity: 0;
        cursor: pointer;
    }

    .tr-option:has(input:focus-visible) {
        outline: 2px solid var(--tr-accent);
        outline-offset: 2px;
    }

    .tr-option-mark {
        flex: none;
        position: relative;
        width: 1rem;
        height: 1rem;
        /* Centre the mark on the first line of the label: 16 px text at 1.5. */
        margin-top: 0.25rem;
        border: 1.5px solid var(--tr-control);
        border-radius: 50%;
    }

    .tr-option-text {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        min-width: 0;
    }

    .tr-option-label {
        color: var(--tr-heading);
        font-size: 1rem;
        font-weight: 500;
        line-height: 1.5;
    }

    .tr-option-description {
        color: var(--tr-muted);
        font-size: 0.875rem;
        line-height: 1.45;
    }

    .tr-question[data-answered] .tr-option-description {
        display: none;
    }

    /* The chosen option: a 2 px gold border drawn inside the 1 px one, so the box keeps its size. */
    .tr-option:has(input:checked) {
        border-color: var(--tr-accent);
        background-color: color-mix(in srgb, var(--tr-accent) 12%, var(--tr-surface));
        box-shadow: inset 0 0 0 1px var(--tr-accent);
    }

    .tr-option:has(input:checked) .tr-option-label {
        font-weight: 600;
    }

    .tr-option:has(input:checked) .tr-option-mark {
        border-color: var(--tr-accent);
    }

    .tr-option:has(input:checked) .tr-option-mark::after {
        content: '';
        position: absolute;
        inset: 2.5px;
        border-radius: 50%;
        background-color: var(--tr-accent);
    }

    @media (prefers-reduced-motion: reduce) {
        .tr-option {
            transition: none;
        }
    }
</style>
