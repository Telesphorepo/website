---
/*
 * The questions at the top of a page, such as "Where do you publish from?" and "Which build tool?".
 * Each question is a row of buttons. A Path block (Path.astro) carries data-<key> attributes and
 * shows only when every one of them matches the current answer.
 *
 * The answers come from the address (?from=github&tool=maven), then from localStorage, then the
 * first option. A click stores the answer under tr-choice-<key>, so another page with the same
 * question opens on it, and writes all answers to the address, so a copied link opens the same steps.
 *
 * The script sets data-tr-<key> on <html> before the blocks below it render, and the generated
 * CSS hides the blocks that do not match, so the page does not flash. Without JavaScript, the
 * buttons stay hidden and every block shows under its own heading.
 */
interface Option {
    value: string;
    label: string;
}

interface Question {
    key: string;
    label: string;
    options: Option[];
}

interface Props {
    questions: Question[];
}

const { questions } = Astro.props;

const data = JSON.stringify(questions.map((q) => ({ key: q.key, values: q.options.map((o) => o.value) })));

// One rule per answer: hide each block that names this key but not this value.
const css = [
    ...questions.flatMap((q) => q.options.map((o) =>
        `html[data-tr-${q.key}="${o.value}"] [data-${q.key}]:not([data-${q.key}~="${o.value}"]){display:none}`)),
    'html[data-tr-choice] .tr-path-title{display:none}',
].join('\n');

const script = `(() => {
    const root = document.getElementById('tr-choice');
    if (!root) return;
    const questions = JSON.parse(root.dataset.choice);
    const html = document.documentElement;
    const params = new URLSearchParams(location.search);
    const read = (key) => { try { return localStorage.getItem('tr-choice-' + key); } catch (e) { return null; } };
    const write = (key, value) => { try { localStorage.setItem('tr-choice-' + key, value); } catch (e) {} };
    const state = {};
    for (const q of questions) {
        const fromUrl = params.get(q.key);
        if (fromUrl && q.values.includes(fromUrl)) {
            state[q.key] = fromUrl;
            write(q.key, fromUrl);
        } else {
            const stored = read(q.key);
            state[q.key] = stored && q.values.includes(stored) ? stored : q.values[0];
        }
    }
    const apply = () => {
        html.setAttribute('data-tr-choice', '');
        for (const q of questions) html.setAttribute('data-tr-' + q.key, state[q.key]);
        for (const button of root.querySelectorAll('button[data-key]')) {
            button.setAttribute('aria-pressed', String(state[button.dataset.key] === button.dataset.value));
        }
        try {
            const url = new URL(location.href);
            for (const q of questions) url.searchParams.set(q.key, state[q.key]);
            history.replaceState(history.state, '', url);
        } catch (e) {}
    };
    root.addEventListener('click', (event) => {
        const button = event.target.closest('button[data-key]');
        if (!button) return;
        state[button.dataset.key] = button.dataset.value;
        write(button.dataset.key, button.dataset.value);
        apply();
    });
    root.hidden = false;
    apply();
})();`;
---

<div id="tr-choice" class="tr-choice not-content" data-choice={data} hidden>
    {questions.map((q, i) => (
        <div class="tr-question" role="group" aria-labelledby={`tr-choice-${q.key}`}>
            <p class="tr-question-label" id={`tr-choice-${q.key}`}>
                <span class="tr-question-number">{i + 1}</span>
                {q.label}
            </p>
            <div class="tr-options">
                {q.options.map((o) => (
                    <button type="button" data-key={q.key} data-value={o.value} aria-pressed="false">{o.label}</button>
                ))}
            </div>
        </div>
    ))}
</div>
<style is:inline set:html={css}></style>
<script is:inline set:html={script}></script>

<style>
    .tr-choice {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        margin-block: 1.5rem 2.5rem;
        padding: 1.25rem;
        border-radius: 12px;
        background-color: var(--tr-surface);
    }

    .tr-choice[hidden] {
        display: none;
    }

    .tr-question-label {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        margin: 0 0 0.625rem;
        color: var(--tr-heading);
        font-size: 1.0625rem;
        font-weight: 600;
        letter-spacing: -0.01em;
    }

    .tr-question-number {
        display: inline-flex;
        flex: none;
        align-items: center;
        justify-content: center;
        width: 1.625rem;
        height: 1.625rem;
        border-radius: 999px;
        background-color: var(--tr-raised);
        color: var(--tr-heading);
        font-size: 0.8125rem;
        font-variant-numeric: tabular-nums;
    }

    .tr-options {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
        padding: 0.25rem;
        border-radius: 10px;
        background-color: var(--tr-page);
    }

    .tr-options button {
        flex: 1 1 9rem;
        min-height: 2.5rem;
        padding: 0.5rem 0.875rem;
        border: 0;
        border-radius: 7px;
        background-color: transparent;
        color: var(--tr-muted);
        font: inherit;
        font-size: 0.9375rem;
        font-weight: 500;
        line-height: 1.2;
        cursor: pointer;
        transition: background-color 120ms ease, color 120ms ease;
    }

    .tr-options button:hover {
        background-color: var(--tr-hover);
        color: var(--tr-heading);
    }

    .tr-options button[aria-pressed='true'] {
        background-color: var(--tr-gold);
        color: var(--tr-gold-ink);
        font-weight: 600;
    }

    .tr-options button[aria-pressed='true']:hover {
        background-color: var(--tr-gold-light);
    }

    .tr-options button:focus-visible {
        outline: 2px solid var(--tr-accent);
        outline-offset: 2px;
    }

    @media (max-width: 30rem) {
        .tr-choice {
            padding: 1rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .tr-options button {
            transition: none;
        }
    }
</style>
