---
/*
 * A question on a page, such as "Which build tool?" or "Which web server?": one line with the
 * question and a dropdown beside it. The dropdown is the same control as the theme switcher of the
 * header (overrides/ThemeSelect.astro): a button with the current answer and a caret, and a
 * listbox panel in the top layer. Arrow keys, Home, End, Enter, Space, Escape and Tab work as in a
 * native select. A Path block (Path.astro) carries data-<key> attributes and shows only when every
 * one of them matches the current answer.
 *
 * A page can hold several Choice blocks, each with its own questions. The answers come from the
 * address (?from=github&tool=maven), then from localStorage, then the first option. A change stores
 * the answer under tr-choice-<key>, so another page with the same question opens on it, and writes
 * the answers to the address, so a copied link opens the same steps.
 *
 * The script sets data-tr-<key> on <html> before the blocks below it render, and the generated
 * CSS hides the blocks that do not match, so the page does not flash. Without JavaScript, the
 * questions stay hidden and every block shows under its own heading.
 */
import { Icon } from '@astrojs/starlight/components';

interface Option {
    value: string;
    label: string;
}

interface Question {
    key: string;
    label: string;
    options: Option[];
}

interface Props {
    questions: Question[];
}

const { questions } = Astro.props;

const data = JSON.stringify(questions.map((q) => ({ key: q.key, values: q.options.map((o) => o.value) })));

// One rule per answer: hide each block that names this key but not this value.
const css = [
    ...questions.flatMap((q) => q.options.map((o) =>
        `html[data-tr-${q.key}="${o.value}"] [data-${q.key}]:not([data-${q.key}~="${o.value}"]){display:none}`)),
    'html[data-tr-choice] .tr-path-title{display:none}',
].join('\n');

// The script sits right after its block, so it finds the block as its previous sibling.
const script = `(() => {
    const root = document.currentScript && document.currentScript.previousElementSibling;
    if (!root || !root.dataset.choice) return;
    const questions = JSON.parse(root.dataset.choice);
    const html = document.documentElement;
    const params = new URLSearchParams(location.search);
    const read = (key) => { try { return localStorage.getItem('tr-choice-' + key); } catch (e) { return null; } };
    const write = (key, value) => { try { localStorage.setItem('tr-choice-' + key, value); } catch (e) {} };
    const state = {};
    for (const q of questions) {
        const fromUrl = params.get(q.key);
        if (fromUrl && q.values.includes(fromUrl)) {
            state[q.key] = fromUrl;
            write(q.key, fromUrl);
        } else {
            const stored = read(q.key);
            state[q.key] = stored && q.values.includes(stored) ? stored : q.values[0];
        }
    }
    const pickers = [...root.querySelectorAll('.tr-question')].map((el) => ({
        key: el.dataset.key,
        trigger: el.querySelector('.tr-choice-trigger'),
        value: el.querySelector('.tr-choice-value'),
        panel: el.querySelector('.tr-choice-panel'),
        options: [...el.querySelectorAll('[role="option"]')],
    }));
    const apply = () => {
        html.setAttribute('data-tr-choice', '');
        for (const q of questions) html.setAttribute('data-tr-' + q.key, state[q.key]);
        for (const p of pickers) {
            for (const o of p.options) {
                const selected = o.dataset.value === state[p.key];
                o.setAttribute('aria-selected', String(selected));
                if (selected) p.value.textContent = o.textContent;
            }
        }
        try {
            const url = new URL(location.href);
            for (const q of questions) url.searchParams.set(q.key, state[q.key]);
            history.replaceState(history.state, '', url);
        } catch (e) {}
    };
    const isOpen = (p) => p.panel.matches(':popover-open');
    const place = (p) => {
        const gap = 6, edge = 8;
        const t = p.trigger.getBoundingClientRect();
        const w = p.panel.offsetWidth, h = p.panel.offsetHeight;
        const below = t.bottom + gap + h <= innerHeight - edge;
        p.panel.style.top = (below ? t.bottom + gap : Math.max(edge, t.top - gap - h)) + 'px';
        p.panel.style.left = Math.min(Math.max(edge, t.left), document.documentElement.clientWidth - w - edge) + 'px';
        p.panel.style.minWidth = t.width + 'px';
        p.panel.dataset.side = below ? 'below' : 'above';
    };
    const open = (p, focus) => {
        if (!isOpen(p)) { p.panel.showPopover(); place(p); }
        const selected = p.options.find((o) => o.getAttribute('aria-selected') === 'true');
        const target = focus === 'last' ? p.options[p.options.length - 1] : (selected || p.options[0]);
        if (target) target.focus({ preventScroll: true });
    };
    const close = (p, returnFocus) => {
        if (!isOpen(p)) return;
        p.panel.hidePopover();
        if (returnFocus) p.trigger.focus();
    };
    const choose = (p, option) => {
        state[p.key] = option.dataset.value;
        write(p.key, option.dataset.value);
        apply();
        close(p, true);
    };
    for (const p of pickers) {
        p.trigger.addEventListener('click', () => { if (isOpen(p)) close(p, true); else open(p, 'selected'); });
        p.trigger.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                e.preventDefault();
                open(p, e.key === 'ArrowUp' ? 'last' : 'selected');
            }
        });
        p.panel.addEventListener('click', (e) => {
            const option = e.target.closest('[role="option"]');
            if (option) choose(p, option);
        });
        p.panel.addEventListener('toggle', (e) => p.trigger.setAttribute('aria-expanded', String(e.newState === 'open')));
        p.panel.addEventListener('keydown', (e) => {
            const i = p.options.indexOf(document.activeElement);
            const last = p.options.length - 1;
            let next = -1;
            switch (e.key) {
                case 'ArrowDown': next = Math.min(i + 1, last); break;
                case 'ArrowUp': next = i === -1 ? last : Math.max(i - 1, 0); break;
                case 'Home': next = 0; break;
                case 'End': next = last; break;
                case 'Enter': case ' ': e.preventDefault(); if (i !== -1) choose(p, p.options[i]); return;
                case 'Escape': case 'Tab': e.preventDefault(); close(p, true); return;
                default: return;
            }
            e.preventDefault();
            p.options[next].focus({ preventScroll: true });
        });
        addEventListener('resize', () => close(p, false));
        addEventListener('scroll', () => close(p, false), { capture: true, passive: true });
    }
    root.hidden = false;
    apply();
})();`;
---

<div class="tr-choice not-content" data-choice={data} hidden>
    {questions.map((q) => (
        <div class="tr-question" data-key={q.key}>
            <span class="tr-question-label" id={`tr-choice-${q.key}-label`}>{q.label}</span>
            <button
                type="button"
                class="tr-choice-trigger"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls={`tr-choice-${q.key}-list`}
                aria-labelledby={`tr-choice-${q.key}-label tr-choice-${q.key}-value`}
            >
                <span class="tr-choice-value" id={`tr-choice-${q.key}-value`}>{q.options[0]?.label}</span>
                <Icon name="down-caret" class="tr-choice-caret" />
            </button>
            <ul
                id={`tr-choice-${q.key}-list`}
                class="tr-choice-panel"
                role="listbox"
                popover="auto"
                tabindex="-1"
                aria-labelledby={`tr-choice-${q.key}-label`}
            >
                {q.options.map((o) => (
                    <li role="option" tabindex="-1" data-value={o.value} aria-selected="false">{o.label}</li>
                ))}
            </ul>
        </div>
    ))}
</div>
<script is:inline set:html={script}></script>
<style is:inline set:html={css}></style>

<style>
    .tr-choice {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-block: 1.5rem 2rem;
    }

    .tr-choice[hidden] {
        display: none;
    }

    .tr-question {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.25rem 0.75rem;
    }

    /* The question takes the type size of the dropdown, so the two read as one control. */
    .tr-question-label {
        color: var(--tr-heading);
        font-size: var(--sl-text-sm);
        font-weight: 500;
    }

    /*
     * The trigger and the panel take the look of the theme switcher in the header: radius, padding,
     * caret, type size, hover and the panel. In the text, the trigger keeps a light fill at rest
     * so that it reads as a control.
     */
    .tr-choice-trigger {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 0.5rem 0.5rem 0.75rem;
        border: 0;
        border-radius: 6px;
        background-color: var(--tr-surface);
        color: var(--tr-heading);
        font: inherit;
        font-size: var(--sl-text-sm);
        font-weight: 500;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
        transition: background-color 150ms ease;
    }

    .tr-choice-trigger:hover,
    .tr-choice-trigger[aria-expanded='true'] {
        background-color: var(--tr-hover);
    }

    .tr-choice-trigger :global(.tr-choice-caret) {
        font-size: 1rem;
        color: var(--tr-muted);
        transition: transform 150ms ease;
    }

    .tr-choice-trigger[aria-expanded='true'] :global(.tr-choice-caret) {
        transform: rotate(180deg);
    }

    .tr-choice-panel {
        position: fixed;
        inset: auto;
        min-width: 9rem;
        margin: 0;
        padding: 0.25rem;
        border: 1px solid var(--tr-line);
        border-radius: 10px;
        background-color: var(--tr-surface);
        box-shadow: 0 12px 28px -12px rgb(0 0 0 / 0.45);
        color: var(--tr-body);
        font-size: var(--sl-text-sm);
        list-style: none;
    }

    .tr-choice-panel[popover]:popover-open {
        animation: tr-choice-panel-in 120ms ease-out;
    }

    .tr-choice-panel[data-side='above']:popover-open {
        animation-name: tr-choice-panel-in-above;
    }

    @keyframes tr-choice-panel-in {
        from {
            opacity: 0;
            transform: translateY(-4px);
        }
    }

    @keyframes tr-choice-panel-in-above {
        from {
            opacity: 0;
            transform: translateY(4px);
        }
    }

    .tr-choice-panel [role='option'] {
        margin: 0;
        padding: 0.5rem 0.75rem;
        border-radius: 4px;
        color: var(--tr-muted);
        white-space: nowrap;
        cursor: pointer;
        user-select: none;
    }

    .tr-choice-panel [role='option']:hover,
    .tr-choice-panel [role='option']:focus {
        background-color: var(--tr-hover);
        color: var(--tr-heading);
    }

    .tr-choice-panel [role='option']:focus-visible {
        outline-offset: -2px;
    }

    .tr-choice-panel [role='option'][aria-selected='true'] {
        background-color: var(--tr-raised);
        color: var(--tr-heading);
        font-weight: 600;
    }

    @media (prefers-reduced-motion: reduce) {
        .tr-choice-trigger,
        .tr-choice-trigger :global(.tr-choice-caret) {
            transition: none;
        }

        .tr-choice-panel[popover]:popover-open {
            animation: none;
        }
    }
</style>
