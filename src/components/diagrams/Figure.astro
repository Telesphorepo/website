---
/*
 * The frame of a diagram: a flat panel on the surface color, with a caption under it. The docs
 * pages are flat, so the frame has no paper, no perforation and no shadow. The summary is the
 * figure's description for screen readers, and the Markdown copy of a page writes the summary in
 * place of the figure (see src/pages/[...slug].md.ts).
 *
 * Colors follow the roles of the docs: heading color for names, body color for text, muted for
 * captions and for what is not in play, gold only for the one thing the reader should look at.
 */
interface Props {
    caption: string;
    summary: string;
}

const { caption, summary } = Astro.props;
---

<figure class="tr-figure not-content">
    <p class="tr-figure-summary sr-only">{summary}</p>
    <div class="stage">
        <slot />
    </div>
    <figcaption>{caption}</figcaption>
</figure>

<style>
    .tr-figure {
        margin-block: 2rem 1.25rem;
        border: 1px solid var(--tr-line);
        border-radius: 8px;
        background-color: var(--tr-surface);
    }

    /* Each diagram adapts to the width of its own panel, not the window. */
    .stage {
        container-type: inline-size;
        padding: 1.25rem 1.25rem 1rem;
        color: var(--tr-body);
        font-size: 0.875rem;
        line-height: 1.45;
    }

    figcaption {
        padding: 0.75rem 1.25rem;
        border-top: 1px solid var(--tr-line);
        color: var(--tr-muted);
        font-size: 0.875rem;
        line-height: 1.45;
    }

    @media (max-width: 30rem) {
        .stage {
            padding: 1rem 0.75rem 0.75rem;
        }

        figcaption {
            padding-inline: 0.75rem;
        }
    }

    .tr-figure :global(p) {
        margin: 0;
    }

    .tr-figure :global(.dg-arrow) {
        flex: none;
        align-self: center;
        color: var(--tr-muted);
    }
</style>
