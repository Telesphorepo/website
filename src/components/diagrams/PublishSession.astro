---
/*
 * The publish-session handshake: prove who you are, get a session for one repo, upload, close.
 * Under it, the life of one session on a 15-minute scale.
 */
import Arrow from './Arrow.astro';
import Figure from './Figure.astro';

const proofs = [
    {
        title: 'Device key',
        text: 'The Gradle plugin or the Maven extension signs a one-time nonce with its Ed25519 key.',
        route: 'POST /api/publish/sessions',
    },
    {
        title: 'CI identity token',
        text: 'GitHub Actions or Jenkins sends its OIDC token. A trust policy must match it.',
        route: 'POST /api/publish/sessions/oidc',
    },
    {
        title: 'By hand',
        text: 'A person signs in to the web UI and enters a fresh second-factor code.',
        route: 'POST /api/publish/sessions/manual',
    },
];

/*
 * The example timeline: a publish that takes 90 seconds, on the default 15-minute limit. The SVG
 * has no viewBox, so its text keeps its size. Every x is a percentage of the width that the data
 * gives, and every y is a whole pixel from the constants.
 */
const ttlMinutes = 15;
const usedMinutes = 1.5;
const pct = (minutes: number) => `${(minutes / ttlMinutes) * 100}%`;
const scale = [0, 5, 10, 15].map((m, i, all) => ({
    x: pct(m),
    label: m === 0 ? '0' : `${m} min`,
    anchor: i === 0 ? 'start' : i === all.length - 1 ? 'end' : 'middle',
}));
const track = { height: 14, tick: 6, labelGap: 10 };
const tickBottom = track.height + track.tick;
const labelY = tickBottom + track.labelGap;
const lifeHeight = labelY + 8;
---

<Figure
    caption="A session works for one repo. After the close, its token opens nothing."
    summary="A publish has four steps. First, the client proves who it is in one of three ways: an enrolled device key signs a one-time nonce (POST /api/publish/sessions), a CI system sends its OIDC token and a trust policy must match it (POST /api/publish/sessions/oidc), or a person enters a fresh second-factor code in the web UI (POST /api/publish/sessions/manual). Second, the server answers with a token that starts with trs_. The token works for one repository and lives at most publish.session_ttl, 15 minutes by default. Third, the client uploads with the token as the HTTP Basic password. Fourth, the client closes the session with DELETE /api/publish/sessions/{id}, or the session expires by itself. In the example, a publish takes 90 seconds and the client closes the session, so the token is dead for the other 13 and a half minutes."
>
    <ol class="flow">
        <li class="col">
            <p class="step">1. Prove who you are</p>
            <ul class="proofs">
                {proofs.map((proof) => (
                    <li class="dg-node">
                        <p class="dg-title">{proof.title}</p>
                        <p>{proof.text}</p>
                        <p class="route"><code>{proof.route}</code></p>
                    </li>
                ))}
            </ul>
        </li>
        <li class="link" aria-hidden="true"><Arrow/></li>
        <li class="col">
            <p class="step">2. Get a session for one repo</p>
            <div class="dg-ticket ticket">
                <code class="token">trs_9c1e4b7a02f3_...</code>
                <dl>
                    <dt>repo</dt><dd>releases</dd>
                    <dt>ends</dt><dd>in 15 min</dd>
                </dl>
            </div>
            <p class="dg-note">The limit is <code>publish.session_ttl</code>. One hour at most.</p>
        </li>
        <li class="link" aria-hidden="true"><Arrow/></li>
        <li class="col">
            <p class="step">3. Upload</p>
            <div class="dg-node">
                <p><code>PUT /maven/releases/...</code></p>
                <p class="sub">The token is the Basic password. Any user name works.</p>
            </div>
            <p class="dg-note">The token also reads this repo. No other repo takes it.</p>
        </li>
        <li class="link" aria-hidden="true"><Arrow/></li>
        <li class="col">
            <p class="step">4. Close</p>
            <div class="dg-node">
                <p><code>DELETE /api/publish/sessions/&#123;id&#125;</code></p>
                <p class="sub"><span class="dg-stamp dg-stamp-muted">closed</span></p>
            </div>
            <p class="dg-note">Or it expires by itself.</p>
        </li>
    </ol>

    <div class="life">
        <p class="life-title">One session, from open to close</p>
        <svg class="life-chart" width="100%" height={lifeHeight} aria-hidden="true">
            <defs>
                <pattern id="ps-dead" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                    <rect width="2" height="7" class="dead"/>
                </pattern>
                <clipPath id="ps-track">
                    <rect width="100%" height={track.height} rx={track.height / 2}/>
                </clipPath>
            </defs>
            <g clip-path="url(#ps-track)">
                <rect class="track" width="100%" height={track.height}/>
                <rect class="used" width={pct(usedMinutes)} height={track.height}/>
                <rect x={pct(usedMinutes)} width={pct(ttlMinutes - usedMinutes)} height={track.height} fill="url(#ps-dead)"/>
            </g>
            {scale.map((s) => (
                <>
                    <line class="tick" x1={s.x} x2={s.x} y1={track.height} y2={tickBottom}/>
                    <text x={s.x} y={labelY} text-anchor={s.anchor}>{s.label}</text>
                </>
            ))}
        </svg>
        <p class="dg-note">A Gradle publish of 90 seconds, then the client closes the session. The token is dead for the other 13.5 minutes.</p>
    </div>
</Figure>

<style>
    .flow {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) 1.5rem minmax(0, 1fr) 1.5rem minmax(0, 1fr) 1.5rem minmax(0, 1fr);
        gap: 0.5rem;
        align-items: start;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .col {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
        min-width: 0;
    }

    /* The step titles are one line box tall: 1.25rem. */
    .step {
        color: var(--tr-heading);
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.25rem;
        letter-spacing: -0.01em;
    }

    /* An arrow sits on the step title row: its 16 px box is centered in the 1.25rem line box. */
    .link {
        display: flex;
        justify-content: center;
        padding-top: calc((1.25rem - 16px) / 2);
    }

    .proofs {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .proofs .dg-node {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .route code,
    .dg-node code {
        overflow-wrap: anywhere;
    }

    .sub {
        margin-top: 0.375rem;
        color: var(--tr-muted);
    }

    .ticket {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }

    .token {
        font-weight: 500;
    }

    dl {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0 0.75rem;
        margin: 0;
    }

    dt {
        color: var(--tr-gold-faint);
    }

    dd {
        margin: 0;
        font-weight: 600;
    }

    /* The life of one session on the 15-minute scale. */
    .life {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 1.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--tr-line);
    }

    .life-title {
        color: var(--tr-heading);
        font-weight: 600;
    }

    .life-chart {
        display: block;
        overflow: visible;
    }

    .track {
        fill: var(--tr-page);
    }

    .used {
        fill: var(--tr-accent);
    }

    .dead {
        fill: var(--tr-line-strong);
    }

    .tick {
        stroke: var(--tr-line-strong);
        stroke-width: 1;
        shape-rendering: crispEdges;
    }

    .life-chart text {
        fill: var(--tr-muted);
        font-family: var(--sl-font);
        font-size: 12px;
        font-variant-numeric: tabular-nums;
        dominant-baseline: central;
    }

    /* Narrow panels: the steps run top to bottom. */
    @container (max-width: 40rem) {
        .flow {
            grid-template-columns: minmax(0, 1fr);
        }

        .link {
            padding-top: 0;
        }

        .link :global(.dg-arrow) {
            rotate: 90deg;
        }
    }
</style>
