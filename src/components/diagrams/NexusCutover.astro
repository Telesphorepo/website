---
/*
 * The move off Nexus in three steps. Each step has its sentence and a small picture of who talks
 * to whom at that point: the repos you pick, the builds that still publish to Nexus while
 * Telesphorepo copies, and the builds that publish to Telesphorepo after the cut-over.
 *
 * The steps share rows through a subgrid, so the three sentences and the three pictures line up
 * across the panel. In a narrow panel the steps run top to bottom.
 */
import Arrow from './Arrow.astro';
import Figure from './Figure.astro';

const repos = [
    { name: 'maven-releases', picked: true },
    { name: 'maven-snapshots', picked: true },
    { name: 'apt-hosted', picked: true },
    { name: 'raw-archive', picked: false },
];
---

<Figure
    caption="Nexus keeps serving your builds until you cut over."
    summary="Moving off Nexus takes three steps. First, add your Nexus server in Telesphorepo and pick the repos. Second, Telesphorepo copies them, then keeps copying new uploads every 15 minutes, while your builds still publish to Nexus. Third, when you are ready, switch your builds to Telesphorepo and press Cut over."
>
    <ol class="steps">
        <li class="step">
            <p class="text"><span class="num">1</span>Add your Nexus server in Telesphorepo and pick the repos.</p>
            <div class="scene">
                <div class="dg-node source">
                    <p class="dg-title">Nexus 3</p>
                    <ul class="repos">
                        {repos.map((repo) => (
                            <li class:list={{ off: !repo.picked }}>
                                <span class="box" aria-hidden="true">{repo.picked && <svg viewBox="0 0 12 12" width="12" height="12"><path d="M2.5 6.5 5 9l4.5-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}</span>
                                <span class="repo-name">{repo.name}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </li>
        <li class="step">
            <p class="text"><span class="num">2</span>Telesphorepo copies them, then keeps copying new uploads every 15 minutes, while your builds still publish to Nexus.</p>
            <div class="scene">
                <div class="flow">
                    <p class="dg-node">Your builds</p>
                    <div class="link"><Arrow/><span class="dg-note">publish</span></div>
                    <p class="dg-node">Nexus</p>
                </div>
                <div class="flow">
                    <p class="dg-node">Nexus</p>
                    <div class="link"><Arrow/><span class="dg-note">every 15 min</span></div>
                    <p class="dg-node here">Telesphorepo</p>
                </div>
            </div>
        </li>
        <li class="step">
            <p class="text"><span class="num">3</span>When you are ready, switch your builds to Telesphorepo and press Cut over.</p>
            <div class="scene">
                <div class="flow">
                    <p class="dg-node">Your builds</p>
                    <div class="link"><Arrow/><span class="dg-note">publish</span></div>
                    <p class="dg-node here">Telesphorepo</p>
                </div>
                <p class="cut"><span class="button">Cut over</span></p>
            </div>
        </li>
    </ol>
</Figure>

<style>
    .steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        grid-template-rows: auto auto;
        gap: 1rem 1.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .step {
        display: grid;
        grid-row: span 2;
        grid-template-rows: subgrid;
        row-gap: 1rem;
        min-width: 0;
    }

    .text {
        display: flex;
        gap: 0.75rem;
        color: var(--tr-heading);
        font-size: 0.9375rem;
        line-height: 1.45;
    }

    .num {
        display: grid;
        flex: none;
        place-items: center;
        width: 1.625rem;
        height: 1.625rem;
        border-radius: 999px;
        background-color: var(--tr-gold);
        color: var(--tr-gold-ink);
        font-size: 0.8125rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .scene {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .source {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .repos {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .repos li {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
    }

    .box {
        display: grid;
        flex: none;
        place-items: center;
        width: 1rem;
        height: 1rem;
        border-radius: 4px;
        background-color: var(--tr-gold);
        color: var(--tr-gold-ink);
    }

    .off .box {
        background-color: transparent;
        box-shadow: inset 0 0 0 1.5px var(--tr-line-strong);
    }

    .off .repo-name {
        color: var(--tr-muted);
    }

    .flow {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 5.5rem minmax(0, 1fr);
        align-items: center;
        gap: 0.5rem;
    }

    .flow .dg-node {
        padding: 0.5rem 0.625rem;
        text-align: center;
        white-space: nowrap;
    }

    .here {
        box-shadow: inset 0 0 0 1.5px var(--tr-accent);
        color: var(--tr-heading);
        font-weight: 600;
    }

    /* The arrow centers on the nodes. Its label hangs under it and takes no height. */
    .link {
        position: relative;
        display: flex;
        justify-content: center;
    }

    .link .dg-note {
        position: absolute;
        top: 100%;
        left: 50%;
        translate: -50% 0;
        font-size: 0.75rem;
        line-height: 1.3;
        white-space: nowrap;
    }

    .cut {
        display: flex;
        justify-content: flex-start;
    }

    /* The button on the source page, drawn as the site's gold button. */
    .button {
        padding: 0.375rem 0.875rem;
        border-radius: 8px;
        background-image: linear-gradient(180deg, var(--tr-gold-light) 0%, var(--tr-gold) 55%, var(--tr-gold-dark) 100%);
        box-shadow: inset 0 1px 0 rgb(255 248 225 / 0.7), inset 0 -1px 0 rgb(110 71 8 / 0.45), 0 1px 0 rgb(5 7 26 / 0.35);
        color: var(--tr-gold-ink);
        font-size: 0.8125rem;
        font-weight: 600;
    }

    /* Narrow panels: the steps run top to bottom. */
    @container (max-width: 46rem) {
        .steps {
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: none;
            row-gap: 1.75rem;
        }

        .step {
            display: flex;
            flex-direction: column;
            gap: 0.875rem;
        }
    }
</style>
