---
/*
 * The warm cut-over from Nexus as a timeline: add the source, mirror with repeated syncs, cut
 * over with one final sync, then publish here. Each phase shows its syncs and what a write to a
 * mapped repo gets.
 *
 * The rail and the sync bars are SVG with no viewBox, so they stretch with the column. The rail
 * is 12 px tall: its dot and its line share the center y 6, and the 2 px line covers the pixel
 * rows 5 and 6. The sync bars take their x and their width from the data, in percent.
 */
import Figure from './Figure.astro';

const rail = { height: 12, stroke: 2 };
const railMid = rail.height / 2;
const dotRadius = railMid - rail.stroke / 2;

// Sync widths in the mirroring phase, in percent: the first sync copies everything, later ones only the changes.
const syncGap = 4;
const syncHeight = 14;
const toBars = (widths: number[]) =>
    widths.map((width, i) => ({
        x: widths.slice(0, i).reduce((sum, w) => sum + w + syncGap, 0),
        width,
    }));
const mirrorSyncs = toBars([46, 7, 5, 8, 5, 6]);
const finalSync = toBars([40]);
---

<Figure
    caption="Mirror while Nexus stays live. Cut over when you are ready to publish here."
    summary="A Nexus cut-over has four phases. Add source: Telesphorepo checks the Nexus login and lists the hosted repos, and you map each one to a target repo. Mirroring: the first sync copies every file, and later syncs run every nexus.sync_interval (15 minutes by default) and copy only new and changed files, because a file with the same SHA-256 is skipped. During mirroring, a write to a mapped repo gets 409, mirrors Nexus source, cut over first. Cut over: you stop publishing to Nexus, and Telesphorepo runs one final sync. Publishing here: the source is cut_over, the mapped repos are writable, and the server deletes the stored Nexus credentials."
>
    <ol class="phases">
        {[
            { name: 'Add source', state: undefined, dot: 'dot' },
            { name: 'Mirroring', state: 'mirroring', dot: 'dot' },
            { name: 'Cut over', state: undefined, dot: 'dot dot-cut' },
            { name: 'Publishing here', state: 'cut_over', dot: 'dot dot-done' },
        ].map((phase, i, all) => (
            <li class="phase">
                <div class="head">
                    <svg class:list={['rail', { 'rail-last': i === all.length - 1 }]} height={rail.height} aria-hidden="true">
                        <line class="rail-line" x1={railMid} x2="100%" y1={railMid} y2={railMid}/>
                        <circle class={phase.dot} cx={railMid} cy={railMid} r={dotRadius}/>
                    </svg>
                    <p><span class="name">{phase.name}</span>{phase.state && <> <code>{phase.state}</code></>}</p>
                </div>
                {i === 0 && (
                    <>
                        <div class="lane">
                            <p class="lane-name">Syncs</p>
                            <p class="dg-note">None yet. The server checks the Nexus login and lists the hosted repos. You map each one to a target.</p>
                        </div>
                        <div class="lane">
                            <p class="lane-name">Writes to a mapped repo</p>
                            <p class="dg-note">Not mapped yet.</p>
                        </div>
                    </>
                )}
                {i === 1 && (
                    <>
                        <div class="lane">
                            <p class="lane-name">Syncs</p>
                            <svg class="syncs" height={syncHeight} aria-hidden="true">
                                {mirrorSyncs.map((bar) => <rect class="sync" x={`${bar.x}%`} width={`${bar.width}%`} height={syncHeight} rx="2"/>)}
                            </svg>
                            <p class="dg-note">The first sync copies everything. Then one every <code>nexus.sync_interval</code> (15 min). Same SHA-256, no copy.</p>
                        </div>
                        <div class="lane">
                            <p class="lane-name">Writes to a mapped repo</p>
                            <p><span class="dg-stamp dg-stamp-bad">409</span></p>
                            <p class="dg-note"><code>mirrors Nexus source &lt;name&gt;; cut over first</code></p>
                        </div>
                    </>
                )}
                {i === 2 && (
                    <>
                        <div class="lane">
                            <p class="lane-name">Syncs</p>
                            <svg class="syncs" height={syncHeight} aria-hidden="true">
                                {finalSync.map((bar) => <rect class="sync sync-final" x={`${bar.x}%`} width={`${bar.width}%`} height={syncHeight} rx="2"/>)}
                            </svg>
                            <p class="dg-note">Stop publishing to Nexus. One final sync runs.</p>
                        </div>
                        <div class="lane">
                            <p class="lane-name">Writes to a mapped repo</p>
                            <p><span class="dg-stamp dg-stamp-bad">409</span></p>
                            <p class="dg-note">Until the final sync ends.</p>
                        </div>
                    </>
                )}
                {i === 3 && (
                    <>
                        <div class="lane">
                            <p class="lane-name">Syncs</p>
                            <p class="dg-note">None. The server deletes the Nexus credentials. The sync history stays.</p>
                        </div>
                        <div class="lane">
                            <p class="lane-name">Writes to a mapped repo</p>
                            <p><span class="dg-stamp dg-stamp-ok">writable</span></p>
                            <p class="dg-note">Point clients and CI here.</p>
                        </div>
                    </>
                )}
            </li>
        ))}
    </ol>
</Figure>

<style>
    .phases {
        --column-gap: 1rem;
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
        grid-template-rows: auto auto auto;
        column-gap: var(--column-gap);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .phase {
        display: grid;
        grid-row: span 3;
        grid-template-rows: subgrid;
        row-gap: 0.75rem;
        min-width: 0;
    }

    /* The phase heads sit on one rail. Each rail runs across its column gap to the next dot. */
    .head {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .rail {
        display: block;
        width: calc(100% + var(--column-gap));
        overflow: visible;
    }

    .rail-last {
        width: 100%;
    }

    .rail-line {
        stroke: var(--tr-line-strong);
        stroke-width: 2;
    }

    .dot {
        fill: var(--tr-surface);
        stroke: var(--tr-muted);
        stroke-width: 2;
    }

    .dot-cut {
        fill: var(--tr-accent);
        stroke: var(--tr-accent);
    }

    .dot-done {
        stroke: var(--tr-ok);
    }

    .name {
        color: var(--tr-heading);
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.25;
    }

    .lane {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        padding-top: 0.625rem;
        border-top: 1px solid var(--tr-line);
    }

    .lane-name {
        color: var(--tr-muted);
        font-size: 0.75rem;
        font-weight: 600;
    }

    .syncs {
        display: block;
        width: 100%;
    }

    .sync {
        fill: var(--tr-muted);
    }

    .sync-final {
        fill: var(--tr-accent);
    }

    /* Narrow panels: the phases run top to bottom, with no rail between them. */
    @container (max-width: 38rem) {
        .phases {
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: none;
            row-gap: 1.5rem;
        }

        .phase {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .head {
            flex-direction: row;
            align-items: center;
            gap: 0.5rem;
        }

        .rail {
            width: 12px;
            flex: none;
        }

        .rail-line {
            display: none;
        }
    }
</style>
