---
/*
 * The scale test: p95 latency of four request-path operations at 100k and at 1M assets, on one
 * axis, with the limit at which the test fails. The numbers come from `go tool task test scale`.
 *
 * The chart is SVG, and every coordinate comes from the data through one scale. An x is a whole
 * number of user units, so a bar end, a limit line and its pin fall on the same pixel column. A
 * 1-unit stroke sits on a half unit, so it covers one whole pixel. There are three layouts of the
 * same chart, and the width of the figure picks one: wide (1040) and medium (720) put the labels
 * left of the bars, narrow (320) puts them above and labels every second tick.
 */
import Figure from '../diagrams/Figure.astro';

const axisMs = 7;
const ticks = Array.from({ length: axisMs + 1 }, (_, t) => t);

// p95 in milliseconds.
const ops = [
    { name: 'Maven GET', detail: 'with If-None-Match', small: 0.586, large: 0.607 },
    { name: 'Asset list page', detail: 'keyset pagination', small: 1.49, large: 1.51 },
    { name: 'Search', detail: 'trigram index', small: 3.38, large: 3.39 },
    { name: 'Token auth', detail: '/api/me', small: 1.03, large: 1.03 },
].map((op) => ({
    ...op,
    // The test fails when the p95 at 1M exceeds max(2 x p95 at 100k, p95 at 100k + 2 ms).
    limit: Math.max(2 * op.small, op.small + 2),
}));

const show = (ms: number) => (ms < 1 ? `${Math.round(ms * 1000)} µs` : `${ms.toFixed(2)} ms`);

// Shared sizes, in user units.
const bar = 12;          // bar height
const barGap = 4;        // between the 100k bar and the 1M bar
const valueGap = 8;      // from a bar end to its value
const pinRadius = 4;     // the circle on top of a limit line
const pinReach = 6;      // how far the limit line runs past the bars, above and below
const axisGap = 8;       // from the last row to the axis line
const tickLabelGap = 14; // from the axis line to the center of a tick label

type Layout = {
    name: 'wide' | 'medium' | 'narrow';
    width: number;
    height: number;
    x0: number;
    x1: number;
    axisY: number;
    grid: number[];
    rows: {
        name: string;
        detail: string;
        labelX: number;
        nameY: number;
        detailY: number;
        bars: { cls: string; y: number; end: number; value: string }[];
        limitX: number;
        limitTop: number;
        limitBottom: number;
        zoneTop: number;
        zoneHeight: number;
    }[];
    ticks: { x: number; label: string; anchor: string }[];
};

/*
 * One layout. With labels on the left, a row is 56 units: the two bars are centered on the row,
 * the name and the detail are centered on the two bars. With labels on top, a row is 96 units:
 * the name and the detail above, then the bars.
 */
function layout(name: Layout['name'], width: number, labelWidth: number, stacked: boolean): Layout {
    const x0 = stacked ? 12 : labelWidth;
    const right = 16;
    const perMs = Math.floor((width - right - x0) / axisMs);
    const x = (ms: number) => x0 + Math.round(Math.min(ms, axisMs) * perMs);
    const x1 = x(axisMs);
    const barsHeight = 2 * bar + barGap;
    const rowHeight = stacked ? 96 : 56;
    const barsOffset = stacked ? 48 : (rowHeight - barsHeight) / 2;

    const rows = ops.map((op, i) => {
        const top = i * rowHeight;
        const barsTop = top + barsOffset;
        const smallCenter = barsTop + bar / 2;
        const largeCenter = barsTop + bar + barGap + bar / 2;
        return {
            name: op.name,
            detail: op.detail,
            labelX: stacked ? x0 : 0,
            nameY: stacked ? top + 10 : smallCenter,
            detailY: stacked ? top + 28 : largeCenter,
            bars: [
                { cls: 'bar-small', y: barsTop, end: x(op.small), value: show(op.small) },
                { cls: 'bar-large', y: barsTop + bar + barGap, end: x(op.large), value: show(op.large) },
            ],
            limitX: x(op.limit),
            limitTop: barsTop - pinReach,
            limitBottom: barsTop + barsHeight + pinReach,
            zoneTop: barsTop - pinReach,
            zoneHeight: barsHeight + 2 * pinReach,
        };
    });

    const axisY = ops.length * rowHeight + axisGap;
    return {
        name,
        width,
        height: axisY + tickLabelGap + 10,
        x0,
        x1,
        axisY,
        rows,
        grid: ticks.slice(1).map(x),
        ticks: ticks.filter((t) => !stacked || t % 2 === 0).map((t) => ({
            x: x(t),
            label: t === 0 ? '0' : `${t} ms`,
            anchor: t === 0 ? 'start' : t === axisMs ? 'end' : 'middle',
        })),
    };
}

const layouts = [
    layout('wide', 1040, 240, false),
    layout('medium', 720, 184, false),
    layout('narrow', 320, 0, true),
];

// The legend keys use the same sizes as the marks.
const key = { w: 20, h: 16 };
const keyBarY = (key.h - bar) / 2;
const keyLineX = key.w / 2;
---

<Figure
    caption="p95 of 400 runs per operation, over HTTP, against the server image. With ten times the assets, no p95 moves by more than 21 µs."
    summary={`The scale test measures the p95 latency of four operations at 100k and at 1M assets. ${ops.map((op) => `${op.name}: ${show(op.small)} at 100k, ${show(op.large)} at 1M.`).join(' ')} An operation fails the test when its p95 at 1M exceeds the larger of twice its p95 at 100k and its p95 at 100k plus 2 ms.`}
>
    <div class="legend" aria-hidden="true">
        <span>
            <svg width={key.w} height={key.h} viewBox={`0 0 ${key.w} ${key.h}`}><rect class="bar-small" y={keyBarY} width={key.w} height={bar} rx="2"/></svg>
            100k assets
        </span>
        <span>
            <svg width={key.w} height={key.h} viewBox={`0 0 ${key.w} ${key.h}`}><rect class="bar-large" y={keyBarY} width={key.w} height={bar} rx="2"/></svg>
            1M assets
        </span>
        <span>
            <svg width={key.w} height={key.h} viewBox={`0 0 ${key.w} ${key.h}`}>
                <rect class="zone" x={keyLineX + 1} y={pinRadius} width={key.w - keyLineX - 1} height={key.h - pinRadius}/>
                <line class="limit" x1={keyLineX} x2={keyLineX} y1={pinRadius} y2={key.h}/>
                <circle class="pin" cx={keyLineX} cy={pinRadius} r={pinRadius}/>
            </svg>
            The limit: the test fails past this line
        </span>
    </div>

    {layouts.map((l) => (
        <svg class:list={['chart', `chart-${l.name}`]} viewBox={`0 0 ${l.width} ${l.height}`} width={l.width} height={l.height} aria-hidden="true">
            <defs>
                <pattern id={`hatch-${l.name}`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                    <rect width="2" height="6" class="hatch"/>
                </pattern>
            </defs>

            {l.rows.map((row) => (
                <g>
                    {l.grid.map((x) => (
                        <line class="grid" x1={x + 0.5} x2={x + 0.5} y1={row.zoneTop} y2={row.zoneTop + row.zoneHeight}/>
                    ))}

                    <text class="name" x={row.labelX} y={row.nameY}>{row.name}</text>
                    <text class="detail" x={row.labelX} y={row.detailY}>{row.detail}</text>

                    <rect x={row.limitX + 1} y={row.zoneTop} width={l.x1 - row.limitX - 1} height={row.zoneHeight} fill={`url(#hatch-${l.name})`}/>

                    {row.bars.map((b) => (
                        <>
                            <rect class={b.cls} x={l.x0} y={b.y} width={b.end - l.x0} height={bar} rx="2"/>
                            <text class="value" x={b.end + valueGap} y={b.y + bar / 2}>{b.value}</text>
                        </>
                    ))}

                    <line class="limit" x1={row.limitX} x2={row.limitX} y1={row.limitTop} y2={row.limitBottom}/>
                    <circle class="pin" cx={row.limitX} cy={row.limitTop} r={pinRadius}/>
                </g>
            ))}

            <line class="axis" x1={l.x0} x2={l.x1} y1={l.axisY + 0.5} y2={l.axisY + 0.5}/>
            {l.ticks.map((t) => (
                <text class="tick" x={t.x} y={l.axisY + tickLabelGap} text-anchor={t.anchor}>{t.label}</text>
            ))}
        </svg>
    ))}
</Figure>

<style>
    .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        margin-bottom: 1.25rem;
        color: var(--tr-muted);
        font-size: 0.8125rem;
    }

    .legend > span {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .legend svg {
        flex: none;
        overflow: visible;
    }

    /* One layout shows at a time. Wide and medium draw at most at their own size. */
    .chart {
        display: none;
        width: 100%;
        height: auto;
        overflow: visible;
    }

    .chart-narrow {
        display: block;
        max-width: 32rem;
    }

    @container (min-width: 45rem) {
        .chart-narrow {
            display: none;
        }

        .chart-medium {
            display: block;
            max-width: 720px;
        }
    }

    @container (min-width: 65rem) {
        .chart-medium {
            display: none;
        }

        .chart-wide {
            display: block;
            max-width: 1040px;
        }
    }

    text {
        font-family: var(--sl-font);
        dominant-baseline: central;
        font-variant-numeric: tabular-nums;
    }

    .name {
        fill: var(--tr-heading);
        font-size: 15px;
        font-weight: 600;
    }

    .detail {
        fill: var(--tr-muted);
        font-size: 13px;
    }

    .value {
        fill: var(--tr-body);
        font-size: 13px;
        font-weight: 500;
    }

    .tick {
        fill: var(--tr-muted);
        font-size: 12px;
    }

    .grid {
        stroke: var(--tr-line);
        stroke-width: 1;
    }

    .axis {
        stroke: var(--tr-line-strong);
        stroke-width: 1;
    }

    .bar-small {
        fill: var(--tr-muted);
    }

    .bar-large {
        fill: var(--tr-accent);
    }

    .limit {
        stroke: var(--tr-stamp);
        stroke-width: 2;
    }

    .pin {
        fill: var(--tr-stamp);
    }

    .zone {
        fill: color-mix(in srgb, var(--tr-stamp) 22%, transparent);
    }

    .hatch {
        fill: color-mix(in srgb, var(--tr-stamp) 22%, transparent);
    }
</style>
