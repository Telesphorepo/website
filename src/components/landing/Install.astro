---
/* The whole install as a manifest: the binary, the database file and the blob store. */
import Figure from '../diagrams/Figure.astro';

const items = [
    {
        path: '/telesphorepo',
        what: 'The binary',
        text: 'The server, the web UI, the JSON API and the format routes, on one port (8080).',
    },
    {
        path: '/data/telesphorepo.db',
        what: 'The database',
        text: 'One SQLite file: users, repos, settings, and an index of every stored file.',
    },
    {
        path: '/data/blobs/  or  s3://bucket',
        what: 'The blobs',
        text: 'The file contents, on local disk or in any S3-compatible bucket: Cloudflare R2, SeaweedFS, AWS S3.',
    },
];
---

<Figure
    caption="Back up the /data volume, and the bucket if you use S3. Unless you set TR_MASTER_KEY, /data also holds master.key, the key that encrypts secret settings."
    summary="The whole install is three things. The binary, /telesphorepo, serves the web UI, the JSON API and the format routes on one port, 8080. One SQLite file, /data/telesphorepo.db, holds users, repos, settings and an index of every stored file. One blob store holds the file contents: /data/blobs/ on local disk, or any S3-compatible bucket such as Cloudflare R2, SeaweedFS or AWS S3."
>
    <dl class="manifest">
        {items.map((item) => (
            <div class="row">
                <dt>
                    <span class="what">{item.what}</span>
                    <code>{item.path}</code>
                </dt>
                <dd>{item.text}</dd>
            </div>
        ))}
    </dl>
</Figure>

<style>
    .manifest {
        margin: 0;
    }

    .row {
        display: grid;
        grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
        gap: 0.375rem 1.5rem;
        padding-block: 0.875rem;
    }

    .row + .row {
        border-top: 1px solid var(--tr-line);
    }

    .row:first-child {
        padding-top: 0;
    }

    .row:last-child {
        padding-bottom: 0;
    }

    dt {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .what {
        color: var(--tr-heading);
        font-family: var(--tr-display);
        font-size: 1.25rem;
        font-stretch: 122%;
        font-weight: 820;
        line-height: 1;
    }

    dt code {
        color: var(--tr-link);
        font-family: var(--sl-font-mono);
        font-size: 0.8125rem;
        white-space: pre-wrap;
    }

    dd {
        margin: 0;
        align-self: end;
        color: var(--tr-body);
    }

    @container (max-width: 34rem) {
        .row {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
