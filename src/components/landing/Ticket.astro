---
/*
 * A gold ticket that carries text: the landing page shows an example publish session on it. It
 * has the geometry of the brand mark (src/assets/brand/README.md) at 8x, so the 64 x 40 mark grid
 * becomes 512 x 320. Every position below is a mark-grid value times U, or a text baseline that
 * the constants give. The stamp lands once, when the ticket first scrolls into view.
 */
interface Props {
    kind: string;
    token: string;
    rows: string[][];
    stub: string[];
    stamp: string;
}

const { kind, token, rows, stub, stamp } = Astro.props;

// The mark grid.
const U = 8;
const W = 64 * U;
const H = 40 * U;
const corner = 4 * U;
const notch = 5 * U;
const mid = H / 2;
const slot = { x: 44 * U, w: 2 * U, h: 4 * U, step: 6 * U, first: 3 * U, count: 6 };
const panelEnd = slot.x;
const stubStart = slot.x + slot.w;

const outline = [
    `M${corner} 0H${W - corner}A${corner} ${corner} 0 0 1 ${W} ${corner}`,
    `V${mid - notch}A${notch} ${notch} 0 0 0 ${W} ${mid + notch}`,
    `V${H - corner}A${corner} ${corner} 0 0 1 ${W - corner} ${H}`,
    `H${corner}A${corner} ${corner} 0 0 1 0 ${H - corner}`,
    `V${mid + notch}A${notch} ${notch} 0 0 0 0 ${mid - notch}`,
    `V${corner}A${corner} ${corner} 0 0 1 ${corner} 0Z`,
].join('');
const r = slot.w / 2;
const slots = Array.from({ length: slot.count }, (_, i) => {
    const y = slot.first + i * slot.step;
    return `M${slot.x} ${y + r}A${r} ${r} 0 0 1 ${slot.x + slot.w} ${y + r}V${y + slot.h - r}A${r} ${r} 0 0 1 ${slot.x} ${y + slot.h - r}Z`;
}).join('');

// The text. The left edge clears the notch (radius 5 units) by one unit.
const left = 6 * U;
const valueX = left + 11 * U;
const kindBaseline = 68;
const tokenBaseline = 102;
const rowBaseline = (i: number) => 140 + i * 30;

// The stub: its lines run up the stub, like the serial on the brand ticket. They are centered on
// the ticket middle and on the free band between the slots and the notch (x 46..59 units).
const stubCenter = (stubStart + W - notch) / 2;
const stubPitch = 24;
const stubLineX = (i: number) => stubCenter + (i - (stub.length - 1) / 2) * stubPitch;

// The stamp: a rubber stamp in the free space under the rows, centered on the main panel.
// The text is set to an exact length, so the frame fits it: 0.6 em per character.
const stampFont = 16;
const stampText = stamp.length * stampFont * 0.6;
const stampPad = 12;
const stampBox = { w: stampText + 2 * stampPad, h: 34 };
const stampCenter = { x: panelEnd / 2 + 2 * U, y: 274 };

const id = `tk${Math.random().toString(36).slice(2, 8)}`;
---

<div class="tr-ticket-lift">
    <svg class="tr-ticket" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${kind} ${token}. ${rows.map(([n, v]) => `${n}: ${v}`).join(', ')}. ${stamp}.`}>
        <defs>
            <linearGradient id={`${id}-foil`} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2={W} y2={H}>
                <stop offset="0" stop-color="#FBE3A0"/>
                <stop offset=".2" stop-color="#EEC05A"/>
                <stop offset=".45" stop-color="#CF972E"/>
                <stop offset=".63" stop-color="#F4D27A"/>
                <stop offset=".8" stop-color="#DDA840"/>
                <stop offset="1" stop-color="#B27C20"/>
            </linearGradient>
            <linearGradient id={`${id}-sheen`} gradientUnits="userSpaceOnUse" x1={W * 0.1} y1="0" x2={W * 0.6} y2={H}>
                <stop offset=".3" stop-color="#FFF8E1" stop-opacity="0"/>
                <stop offset=".44" stop-color="#FFF8E1" stop-opacity=".5"/>
                <stop offset=".52" stop-color="#FFF8E1" stop-opacity=".12"/>
                <stop offset=".6" stop-color="#FFF8E1" stop-opacity="0"/>
            </linearGradient>
            <filter id={`${id}-grain`} x="0" y="0" width="100%" height="100%">
                <feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" seed="7" result="n"/>
                <feColorMatrix in="n" values="0 0 0 0 .43 0 0 0 0 .28 0 0 0 0 .03 0 0 0 .22 0"/>
                <feComposite in2="SourceGraphic" operator="in"/>
            </filter>
            <clipPath id={`${id}-clip`}>
                <path d={outline + slots} fill-rule="evenodd" clip-rule="evenodd"/>
            </clipPath>
        </defs>

        <g clip-path={`url(#${id}-clip)`}>
            <rect width={W} height={H} fill={`url(#${id}-foil)`}/>
            <rect width={W} height={H} fill={`url(#${id}-sheen)`}/>
            <rect width={W} height={H} fill="#000" filter={`url(#${id}-grain)`}/>
            <!-- The card edge: light along the top, dark along the bottom. -->
            <rect width={W} height="2" fill="#FFF3CC" opacity=".7"/>
            <rect y={H - 2} width={W} height="2" fill="#6E4708" opacity=".45"/>
        </g>

        <g class="ink">
            <text class="kind" x={left} y={kindBaseline}>{kind}</text>
            <text class="token" x={left} y={tokenBaseline}>{token}</text>
            {rows.map(([name, value], i) => (
                <>
                    <text class="dt" x={left} y={rowBaseline(i)}>{name}</text>
                    <text class="dd" x={valueX} y={rowBaseline(i)}>{value}</text>
                </>
            ))}
            {stub.map((line, i) => (
                <text class="stub" x={stubLineX(i)} y={mid} transform={`rotate(-90 ${stubLineX(i)} ${mid})`}>{line}</text>
            ))}
        </g>

        <g transform={`rotate(-8 ${stampCenter.x} ${stampCenter.y})`}>
            <g class="stamp" data-stamp>
                <rect x={stampCenter.x - stampBox.w / 2} y={stampCenter.y - stampBox.h / 2} width={stampBox.w} height={stampBox.h} rx="5"/>
                <text x={stampCenter.x} y={stampCenter.y} textLength={stampText} lengthAdjust="spacing">{stamp}</text>
            </g>
        </g>
    </svg>
</div>

<script>
    // Mark each ticket when it first shows, so its stamp lands then. Without the observer, the stamp is already down.
    const tickets = document.querySelectorAll<HTMLElement>('.tr-ticket-lift');
    if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
            for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.setAttribute('data-shown', '');
                observer.unobserve(entry.target);
            }
        }, { threshold: 0.6 });
        tickets.forEach((ticket) => {
            ticket.setAttribute('data-waiting', '');
            observer.observe(ticket);
        });
    }
</script>

<style>
    .tr-ticket-lift {
        width: min(100%, 27rem);
        rotate: -2deg;
        filter: drop-shadow(0 2px 2px rgb(5 7 26 / 0.35)) drop-shadow(0 16px 22px rgb(5 7 26 / 0.45));
    }

    :global(:root[data-theme='light']) .tr-ticket-lift {
        filter: drop-shadow(0 1px 1px rgb(60 40 5 / 0.3)) drop-shadow(0 12px 18px rgb(60 40 5 / 0.22));
    }

    .tr-ticket {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }

    text {
        font-family: var(--sl-font);
        dominant-baseline: alphabetic;
    }

    /* Printed ink: Carbon for the values, the brand's printed brown for the names. */
    .kind {
        fill: #131838;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -0.03em;
    }

    .token {
        fill: #131838;
        font-size: 17px;
        font-weight: 500;
    }

    .dt {
        fill: #5c3f08;
        font-size: 18px;
    }

    .dd {
        fill: #131838;
        font-size: 18px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    .stub {
        fill: #131838;
        font-size: 17px;
        font-weight: 700;
        text-anchor: middle;
        dominant-baseline: central;
    }

    /* A carbon-blue rubber stamp. */
    .stamp {
        transform-box: fill-box;
        transform-origin: center;
        opacity: 0.85;
        mix-blend-mode: multiply;
    }

    .stamp rect {
        fill: none;
        stroke: #2236a8;
        stroke-width: 3;
    }

    .stamp text {
        fill: #2236a8;
        font-size: 16px;
        font-weight: 700;
        text-anchor: middle;
        dominant-baseline: central;
        font-variant-numeric: tabular-nums;
    }

    [data-waiting] .stamp {
        opacity: 0;
    }

    [data-shown] .stamp {
        animation: tr-stamp 360ms cubic-bezier(0.2, 0.9, 0.3, 1.15) 250ms both;
    }

    @keyframes tr-stamp {
        from {
            opacity: 0;
            scale: 1.7;
        }
        to {
            opacity: 0.85;
            scale: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        [data-waiting] .stamp,
        [data-shown] .stamp {
            opacity: 0.85;
            animation: none;
        }
    }
</style>
