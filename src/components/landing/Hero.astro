---
/*
 * Replaces Starlight's Hero. The landing page shows its title across the page, then the tagline,
 * the actions and the one command that runs the server. The 404 page shows a void ticket.
 */
import Ticket from './Ticket.astro';

const { entry } = Astro.locals.starlightRoute;
const { data } = entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const notFound = entry.id === '404';
const command = 'docker run -d -p 8080:8080 -v telesphorepo-data:/data ghcr.io/telesphorepo/telesphorepo:latest';
---

<div class="tr-hero">
    <h1 id="_top" data-page-title set:html={title}/>

    <div class="lower">
        <div class="copy">
            {tagline && <div class="tagline" set:html={tagline}/>}
            {actions.length > 0 && (
                <div class="actions">
                    {actions.map(({ link, text, variant }) => (
                        <a href={link} class:list={['tr-button', variant === 'primary' ? 'tr-button-primary' : 'tr-button-secondary']}>{text}</a>
                    ))}
                </div>
            )}
        </div>

        {notFound ? (
            <div class="void" aria-hidden="true">
                <Ticket kind="Page" token="404" rows={[['path', 'not on any shelf']]} stub={['No', 'entry']} stamp="Void" tilt={3}/>
            </div>
        ) : (
            <div class="run">
                <p class="run-title">Run it</p>
                <div class="run-line">
                    <code>{command}</code>
                    <button type="button" class="copy-button" data-copy-command={command}>
                        <span data-copy-label aria-live="polite">Copy</span>
                    </button>
                </div>
                <p class="run-note">
                    Then open port 8080. The first start prints the <code>admin</code> password to the
                    container log. The image runs on <code>linux/amd64</code> and <code>linux/arm64</code>.
                </p>
            </div>
        )}
    </div>
</div>

<script>
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-command]')) {
        const label = button.querySelector('[data-copy-label]')!;
        let reset: number | undefined;
        button.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(button.dataset.copyCommand!);
                label.textContent = 'Copied';
            } catch {
                label.textContent = 'Copy failed';
            }
            button.dataset.state = 'done';
            window.clearTimeout(reset);
            reset = window.setTimeout(() => {
                label.textContent = 'Copy';
                delete button.dataset.state;
            }, 2000);
        });
    }
</script>

<style>
    .tr-hero {
        display: flex;
        flex-direction: column;
        gap: clamp(2rem, 1.5rem + 2vw, 3rem);
        padding-block: clamp(2.5rem, 1rem + 7vmin, 5.5rem) 2rem;
    }

    /* The headline: Archivo at its widest, the loudest thing on the site. */
    .tr-hero #_top {
        max-width: 17ch;
        margin: 0;
        font-size: clamp(2.375rem, 1.25rem + 5vw, 5.25rem);
        font-stretch: 125%;
        font-weight: 850;
        line-height: 0.98;
        letter-spacing: -0.025em;
        text-wrap: balance;
    }

    .lower {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2.5rem;
        align-items: start;
    }

    @media (min-width: 56rem) {
        .lower {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
            gap: 4rem;
        }
    }

    .copy {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }

    .tagline {
        max-width: 36rem;
        color: var(--tr-body);
        font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
        line-height: 1.6;
        text-wrap: pretty;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    /* The run slip: the whole install, one line. */
    .run {
        display: flex;
        flex-direction: column;
        gap: 0.875rem;
        padding: 1.25rem;
        border-radius: 12px;
        background-color: var(--tr-surface);
    }

    .run p {
        margin: 0;
    }

    .run-title {
        color: var(--tr-heading);
        font-family: var(--tr-display);
        font-size: 1.0625rem;
        font-stretch: 118%;
        font-weight: 780;
    }

    .run-line {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.75rem;
        align-items: start;
        padding: 0.875rem 0.875rem 0.875rem 1rem;
        border-radius: 8px;
        background-color: var(--tr-page);
    }

    .run-line code {
        color: var(--tr-heading);
        font-family: var(--sl-font-mono);
        font-size: 0.875rem;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .copy-button {
        padding: 0.375rem 0.75rem;
        border: 0;
        border-radius: 999px;
        background-color: var(--tr-raised);
        color: var(--tr-heading);
        font: inherit;
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 150ms ease;
    }

    .copy-button:hover {
        background-color: var(--tr-hover);
    }

    .copy-button[data-state='done'] {
        background-color: var(--tr-ticket);
        color: var(--tr-ticket-ink);
    }

    .run-note {
        color: var(--tr-muted);
        font-size: 0.875rem;
        line-height: 1.55;
    }

    .run-note code {
        color: var(--tr-body);
        font-family: var(--sl-font-mono);
        font-size: 0.8125rem;
    }

    .void {
        display: flex;
        justify-content: center;
        padding-block: 1rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .copy-button {
            transition: none;
        }
    }
</style>
