---
/*
 * Replaces Starlight's Hero. The landing page shows its title, tagline and actions next to an
 * example publish session, drawn as the yellow ticket. The 404 page shows a void ticket.
 */
const { entry } = Astro.locals.starlightRoute;
const { data } = entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const notFound = entry.id === '404';
---

<div class="tr-hero">
    <div class="copy">
        <h1 id="_top" data-page-title set:html={title}/>
        {tagline && <div class="tagline" set:html={tagline}/>}
        {actions.length > 0 && (
            <div class="actions">
                {actions.map(({ link, text, variant }) => (
                    <a href={link} class:list={['tr-button', variant === 'primary' ? 'tr-button-primary' : 'tr-button-secondary']}>{text}</a>
                ))}
            </div>
        )}
    </div>

    {notFound ? (
        <div class="desk" aria-hidden="true">
            <div class="lift"><div class="ticket">
                <div class="main">
                    <p class="kind">Page</p>
                    <p class="token">404</p>
                    <dl>
                        <dt>path</dt><dd>not on any shelf</dd>
                    </dl>
                </div>
                <div class="stub"><span>No entry</span></div>
                <span class="stamp">Void</span>
            </div></div>
        </div>
    ) : (
        <figure class="desk">
            <div class="lift"><div class="ticket">
                <div class="main">
                    <p class="kind">Publish session</p>
                    <p class="token"><code>trs_9c1e4b7a02f3_...</code></p>
                    <dl>
                        <dt>repo</dt><dd>releases</dd>
                        <dt>via</dt><dd>device, Gradle</dd>
                        <dt>opened</dt><dd>14:02:11</dd>
                        <dt>expires</dt><dd>14:17:11</dd>
                    </dl>
                </div>
                <div class="stub"><span>One repo</span><span>15 min</span></div>
                <span class="stamp">Closed 14:03:41</span>
            </div></div>
            <figcaption>An example session. The Gradle plugin closed it after a 90-second publish.</figcaption>
        </figure>
    )}
</div>

<style>
    .tr-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 3rem;
        align-items: center;
        padding-block: clamp(2.5rem, 1rem + 7vmin, 5.5rem) 3rem;
    }

    @media (min-width: 52rem) {
        .tr-hero {
            grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
            gap: 4rem;
        }
    }

    .copy {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .copy #_top {
        max-width: 12ch;
        margin: 0;
        font-size: clamp(3.25rem, 2rem + 5.5vw, 6rem);
        font-weight: 850;
        line-height: 0.92;
        letter-spacing: 0;
        text-wrap: balance;
    }

    .tagline {
        max-width: 34rem;
        color: var(--tr-body);
        font-size: clamp(1rem, 0.925rem + 0.4vw, 1.1875rem);
        line-height: 1.6;
        text-wrap: pretty;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    /* The ticket. */

    .desk {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
        margin: 0;
    }

    /* The shadow sits on a wrapper: a mask on the ticket would cut it off. */
    .lift {
        width: min(100%, 26rem);
        rotate: -2deg;
        filter: drop-shadow(0 18px 24px rgb(0 0 0 / 0.35));
    }

    :root[data-theme='light'] .lift {
        filter: drop-shadow(0 14px 18px rgb(15 30 23 / 0.2));
    }

    .ticket {
        --notch: 12px;
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 5.5rem;
        border-radius: 8px;
        background-color: var(--tr-ticket);
        color: var(--tr-ticket-ink);
        mask:
            radial-gradient(circle var(--notch) at 0 50%, transparent 98%, #000) left / 51% 100% no-repeat,
            radial-gradient(circle var(--notch) at 100% 50%, transparent 98%, #000) right / 51% 100% no-repeat;
    }


    .main {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        /* The bottom padding keeps a clear space for the stamp, so it never covers a value. */
        padding: 1.5rem 1.25rem 4rem 2rem;
    }

    .kind {
        margin: 0;
        font-family: var(--tr-display);
        font-size: 1.5rem;
        font-weight: 800;
        line-height: 1;
    }

    .token {
        margin: 0;
        font-size: 1rem;
        font-weight: 650;
        font-variation-settings: 'MONO' 1;
        overflow-wrap: anywhere;
    }

    .token code {
        color: inherit;
        font-size: inherit;
    }

    dl {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.125rem 1rem;
        margin: 0.25rem 0 0;
        font-size: 0.875rem;
    }

    dt {
        color: var(--tr-ticket-faint);
    }

    dd {
        margin: 0;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    /* The stub, behind a row of punched holes. */
    .stub {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
        padding: 1rem 1.25rem 1rem 0.75rem;
        background-image: radial-gradient(circle, var(--tr-page) 2.5px, transparent 3px);
        background-size: 8px 12px;
        background-repeat: repeat-y;
        background-position: left center;
        font-family: var(--tr-display);
        font-size: 1.125rem;
        font-weight: 800;
        line-height: 1.1;
        text-align: center;
    }

    .stamp {
        position: absolute;
        right: 6.5rem;
        bottom: 1.125rem;
        padding: 0.25rem 0.625rem;
        border: 3px solid var(--tr-ticket-stamp);
        border-radius: 4px;
        color: var(--tr-ticket-stamp);
        font-size: 1rem;
        font-weight: 800;
        font-variation-settings: 'MONO' 1, 'CASL' 1;
        rotate: -9deg;
        opacity: 0.88;
        mix-blend-mode: multiply;
        animation: tr-stamp 380ms cubic-bezier(0.2, 0.9, 0.3, 1.15) 600ms both;
    }

    @keyframes tr-stamp {
        from {
            opacity: 0;
            scale: 1.6;
        }
        to {
            opacity: 0.88;
            scale: 1;
        }
    }

    .desk figcaption {
        max-width: 24rem;
        color: var(--tr-muted);
        font-size: var(--sl-text-sm);
        font-variation-settings: 'CASL' 1;
        text-align: center;
    }

    @media (max-width: 30rem) {
        .ticket {
            grid-template-columns: minmax(0, 1fr) 4.5rem;
        }

        .main {
            padding-left: 1.5rem;
        }

        .stamp {
            right: 5rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .stamp {
            animation: none;
        }
    }
</style>
