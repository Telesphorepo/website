---
/*
 * Replaces Starlight's Hero. The landing page shows the title, the tagline and the actions next to
 * the felt ticket from the brand, then the one command that runs the server. The 404 page
 * shows the same ticket with a void stamp.
 *
 * The ticket file is 720 x 480. The ticket itself is the flat mark at 10x (640 x 400) at offset
 * (40, 32); the margin holds the drop shadow. The void stamp sits on the center of the T's box: the
 * box center is (22.5, 20) in mark units, so (40 + 225, 32 + 200) = (265, 232) in the file.
 */
import ticketUrl from '../../assets/brand/ticket-skeuomorphic.svg?url';

const { entry } = Astro.locals.starlightRoute;
const { data } = entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const notFound = entry.id === '404';
const command = 'docker run -d -p 8080:8080 -v telesphorepo-data:/data ghcr.io/telesphorepo/telesphorepo:latest';

const file = { width: 720, height: 480 };
const tCenter = { x: 40 + 22.5 * 10, y: 32 + 20 * 10 };
const stampAt = `left: ${(tCenter.x / file.width) * 100}%; top: ${(tCenter.y / file.height) * 100}%`;
---

<div class="tr-hero">
    <div class="copy">
        <h1 id="_top" data-page-title set:html={title}/>
        {tagline && <div class="tagline" set:html={tagline}/>}
        {actions.length > 0 && (
            <div class="actions">
                {actions.map(({ link, text, variant }) => (
                    <a href={link} class:list={['tr-button', variant === 'primary' ? 'tr-button-primary' : 'tr-button-secondary']}>{text}</a>
                ))}
            </div>
        )}
    </div>

    <div class="ticket" aria-hidden="true">
        <img src={ticketUrl} width={file.width} height={file.height} alt="" decoding="async" fetchpriority="high"/>
        {notFound && <span class="void" style={stampAt}>Void</span>}
    </div>

    {!notFound && (
        <div class="run tr-paper">
            <p class="run-title">Run it</p>
            <div class="run-line">
                <code>{command}</code>
                <button type="button" class="copy-button" data-copy-command={command}>
                    <span data-copy-label aria-live="polite">Copy</span>
                </button>
            </div>
            <p class="run-note">
                Then open port 8080. The first start prints the <code>admin</code> password to the
                container log. The image runs on <code>linux/amd64</code> and <code>linux/arm64</code>.
            </p>
        </div>
    )}
</div>

<script>
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-command]')) {
        const label = button.querySelector('[data-copy-label]')!;
        let reset: number | undefined;
        button.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(button.dataset.copyCommand!);
                label.textContent = 'Copied';
            } catch {
                label.textContent = 'Copy failed';
            }
            button.dataset.state = 'done';
            window.clearTimeout(reset);
            reset = window.setTimeout(() => {
                label.textContent = 'Copy';
                delete button.dataset.state;
            }, 2000);
        });
    }
</script>

<style>
    /* The copy and the ticket side by side from 56rem, the run slip across both under them. */
    .tr-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2.5rem;
        align-items: center;
        padding-block: clamp(2rem, 1rem + 5vmin, 4.5rem) 2rem;
    }

    @media (min-width: 56rem) {
        .tr-hero {
            grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
            column-gap: 3rem;
        }

        .run {
            grid-column: 1 / -1;
        }
    }

    .copy {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .tr-hero #_top {
        max-width: 16ch;
        margin: 0;
        font-size: clamp(2.375rem, 1.25rem + 4.2vw, 4.25rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.035em;
        text-wrap: balance;
    }

    .tagline {
        max-width: 36rem;
        color: var(--tr-body);
        font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
        line-height: 1.6;
        text-wrap: pretty;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 0.25rem;
    }

    /*
     * The ticket. The file carries its own shadow. A slight turn makes it a card on a desk. The
     * brand asks for the flat mark below 320 px wide, so the ticket keeps at least that width
     * where the screen has room for it.
     */
    .ticket {
        position: relative;
        justify-self: center;
        width: min(100%, 38rem);
        min-width: min(20rem, 100%);
        rotate: -4deg;
    }

    .ticket img {
        display: block;
        width: 100%;
        height: auto;
    }

    /* A red rubber stamp. Its center is the T center, so it moves back by half its own size. */
    .void {
        position: absolute;
        translate: -50% -50%;
        rotate: -12deg;
        padding: 0.125em 0.5em;
        border: 0.12em solid #b3261e;
        border-radius: 0.18em;
        color: #b3261e;
        font-size: clamp(2rem, 1.25rem + 3vw, 3.5rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.04em;
        mix-blend-mode: multiply;
        opacity: 0.85;
    }

    /* The run slip: the whole install, one line. */
    .run {
        display: flex;
        flex-direction: column;
        gap: 0.875rem;
        padding: 1.25rem;
        border-radius: 14px;
    }

    .run p {
        margin: 0;
    }

    .run-title {
        color: var(--tr-heading);
        font-size: 1.0625rem;
        font-weight: 600;
        letter-spacing: -0.015em;
    }

    .run-line {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.75rem;
        align-items: center;
        padding: 0.75rem 0.75rem 0.75rem 1rem;
        border-radius: 8px;
        background-color: var(--tr-page);
        box-shadow: inset 0 1px 2px rgb(5 7 26 / 0.35);
    }

    .run-line code {
        color: var(--tr-heading);
        font-family: var(--sl-font-mono);
        font-size: 0.875rem;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .copy-button {
        padding: 0.375rem 0.875rem;
        border: 0;
        border-radius: 8px;
        background-color: var(--tr-raised);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.07), 0 1px 0 rgb(5 7 26 / 0.4);
        color: var(--tr-heading);
        font: inherit;
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 150ms ease;
    }

    .copy-button:hover {
        background-color: var(--tr-hover);
    }

    .copy-button:active {
        translate: 0 1px;
        box-shadow: none;
    }

    .copy-button[data-state='done'] {
        background-color: var(--tr-gold);
        color: var(--tr-gold-ink);
    }

    .run-note {
        color: var(--tr-muted);
        font-size: 0.875rem;
        line-height: 1.55;
    }

    .run-note code {
        color: var(--tr-body);
        font-family: var(--sl-font-mono);
        font-size: 0.8125rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .copy-button {
            transition: none;
        }
    }
</style>
