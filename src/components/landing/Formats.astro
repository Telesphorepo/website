---
/* The formats the server hosts, each with the route it answers and a guide. */
const formats = [
    {
        name: 'Maven',
        route: '/maven/{repo}/',
        text: 'Artifacts with their checksums. A release file never changes. Metadata and SNAPSHOT files can.',
        href: '/repositories/maven-gradle/',
    },
    {
        name: 'Gradle plugins',
        route: '/maven/{repo}/',
        text: 'Builds and Gradle plugins use a maven repo. The Gradle plugin gets its own publish sessions.',
        href: '/publishing/gradle-plugin/',
    },
    {
        name: 'Debian',
        route: '/debian/{repo}/',
        text: 'A signed apt repository. Upload a .deb and the server builds the indexes.',
        href: '/repositories/debian/',
    },
    {
        name: 'Raw',
        route: '/raw/{repo}/',
        text: 'Plain files at any path. Each repo allows or denies overwrites.',
        href: '/repositories/raw/',
    },
];
---

<ul class="tr-formats not-content" aria-label="Formats">
    {formats.map((format) => (
        <li>
            <a class="tr-paper" href={format.href}>
                <span class="name">{format.name}</span>
                <code class="route">{format.route}</code>
                <span class="text">{format.text}</span>
            </a>
        </li>
    ))}
</ul>

<style>
    /* One, two or four columns, so the row always spans the full content width. */
    .tr-formats {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0.5rem;
        margin: 2rem 0 0;
        padding: 0;
        list-style: none;
    }

    @media (min-width: 36rem) {
        .tr-formats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 64rem) {
        .tr-formats {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    a {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        height: 100%;
        padding: 1.25rem;
        border-radius: 12px;
        color: var(--tr-body);
        text-decoration: none;
        transition: background-color 150ms ease;
    }

    a:hover {
        background-color: var(--tr-hover);
    }

    .name {
        color: var(--tr-heading);
        font-size: 1.375rem;
        font-weight: 600;
        letter-spacing: -0.025em;
        line-height: 1.05;
    }

    .route {
        color: var(--tr-link);
        font-family: var(--sl-font-mono);
        font-size: 0.8125rem;
    }

    .text {
        color: var(--tr-muted);
        font-size: 0.875rem;
        line-height: 1.5;
    }

    @media (prefers-reduced-motion: reduce) {
        a {
            transition: none;
        }
    }
</style>
