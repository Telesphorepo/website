---
/*
 * The publish session in four equal steps, for the landing page. Each step is one tile: its
 * number and name, one sentence, and a small picture in a well of the same height in every
 * tile. The publishing overview in the docs has the full diagram with the routes.
 */
import Figure from '../diagrams/Figure.astro';

const proofs = [
    { label: 'Device key', icon: 'M7.5 16.5a4 4 0 1 1 0-8 4 4 0 0 1 0 8ZM11.5 12.5H21M18 12.5V16M21 12.5V15' },
    { label: 'CI identity token', icon: 'M6 4v10M6 14a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM18 10a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM18 10c0 4-6 3-12 6' },
    { label: 'Second-factor code', icon: 'M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3ZM9 12l2 2 4-4' },
];

const files = ['app-1.4.0.jar', 'app-1.4.0.pom'];
---

<Figure
    caption="A session works for one repo. After the close, its token opens nothing."
    summary="A publish has four steps. First, the client proves who it is with a device key, a CI identity token or a second-factor code. Second, the server gives it a session: a token for one repo that ends after 15 minutes. Third, the build uploads its files with the token. Fourth, the client closes the session, and the token stops working."
>
    <ol class="steps">
        <li class="step">
            <p class="name"><span class="num">1</span>Prove who you are</p>
            <p class="text">The client proves who it is in one of three ways.</p>
            <div class="well">
                <ul class="proofs">
                    {proofs.map((proof) => (
                        <li>
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={proof.icon} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            {proof.label}
                        </li>
                    ))}
                </ul>
            </div>
        </li>
        <li class="step">
            <p class="name"><span class="num">2</span>Get a session</p>
            <p class="text">The server gives a token for one repo that ends after 15 minutes.</p>
            <div class="well">
                <dl class="dg-ticket session">
                    <dt>repo</dt><dd>releases</dd>
                    <dt>ends in</dt><dd>15 min</dd>
                </dl>
            </div>
        </li>
        <li class="step">
            <p class="name"><span class="num">3</span>Upload</p>
            <p class="text">The build uploads its files with that token.</p>
            <div class="well">
                <ul class="files">
                    {files.map((file) => (
                        <li>
                            <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2.5 6.5 5 9l4.5-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            {file}
                        </li>
                    ))}
                </ul>
            </div>
        </li>
        <li class="step">
            <p class="name"><span class="num">4</span>Close</p>
            <p class="text">The client closes the session, and the token stops working.</p>
            <div class="well">
                <span class="dg-stamp dg-stamp-muted closed">Closed</span>
            </div>
        </li>
    </ol>
</Figure>

<style>
    /* Four columns, two in a medium panel, one in a narrow one. The rows line up through a subgrid. */
    .steps {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .step {
        display: grid;
        grid-row: span 3;
        grid-template-rows: subgrid;
        row-gap: 0.5rem;
        min-width: 0;
        margin: 0;
        padding: 1rem;
        border-radius: 10px;
        background-color: var(--tr-page);
    }

    .name {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        color: var(--tr-heading);
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -0.01em;
    }

    .num {
        display: grid;
        flex: none;
        place-items: center;
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 999px;
        background-color: var(--tr-gold);
        color: var(--tr-gold-ink);
        font-size: 0.8125rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .text {
        color: var(--tr-body);
        text-wrap: pretty;
    }

    /* The picture well: the same height in every step, with its picture in the middle. */
    .well {
        display: grid;
        place-items: center;
        min-height: 7.25rem;
        margin-top: 0.375rem;
        padding: 0.75rem;
        border-radius: 8px;
        background-color: var(--tr-surface);
    }

    .proofs,
    .files {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        width: 100%;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .proofs li {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        padding: 0.3125rem 0.625rem;
        border-radius: 6px;
        background-color: var(--tr-raised);
        color: var(--tr-heading);
        font-weight: 500;
    }

    .proofs svg {
        flex: none;
        color: var(--tr-accent);
    }

    .files li {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        padding: 0.3125rem 0.625rem;
        border-radius: 6px;
        background-color: var(--tr-raised);
        color: var(--tr-heading);
        font-weight: 500;
    }

    .files svg {
        flex: none;
        color: var(--tr-ok);
    }

    .session {
        display: grid;
        grid-template-columns: auto auto;
        gap: 0.125rem 0.875rem;
        margin: 0;
    }

    .session dt {
        color: var(--tr-gold-faint);
    }

    .session dd {
        margin: 0;
        font-weight: 600;
    }

    .well .closed {
        padding: 0.25rem 1rem;
        font-size: 1.375rem;
        line-height: 2rem;
    }

    @container (max-width: 52rem) {
        .steps {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @container (max-width: 28rem) {
        .steps {
            grid-template-columns: minmax(0, 1fr);
        }

        .well {
            min-height: 0;
        }
    }
</style>
