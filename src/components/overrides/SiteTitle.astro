---
/*
 * The Telesphorepo lockup (the flat ticket mark and the wordmark, from src/assets/brand) and the header links from
 * starlight-utils. This replaces the starlight-utils SiteTitle override, so it also renders the
 * leading nav links that the starlight-utils route middleware puts in Astro.locals.starlightUtils.navLinks.
 * Each brand file has fixed colors, so the header holds the dark and the light version and the theme
 * shows one. Both draw at scale 0.75 (30 px tall), so on a 2x screen every edge of the mark falls
 * on a whole device pixel. The lockup is 254.34 x 40 units, 190.76 x 30 px. Below 30rem the header
 * shows only the mark, 48 x 30 px.
 */
import Lockup from '../../assets/brand/lockup-horizontal.svg';
import LockupOnDark from '../../assets/brand/lockup-horizontal-on-dark.svg';
import Mark from '../../assets/brand/logo-mark.svg';
import MarkOnLight from '../../assets/brand/logo-mark-on-light.svg';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const navLinks = Astro.locals.starlightUtils?.navLinks ?? [];
---

<div class="tr-title-bar">
    <a href={siteTitleHref} class="tr-site-title" translate="no" aria-label={siteTitle}>
        <LockupOnDark class="tr-lockup tr-on-dark" aria-hidden="true"/>
        <Lockup class="tr-lockup tr-on-light" aria-hidden="true"/>
        <Mark class="tr-mark tr-on-dark" aria-hidden="true"/>
        <MarkOnLight class="tr-mark tr-on-light" aria-hidden="true"/>
    </a>
    {navLinks.length > 0 && (
        <ul class="tr-nav-links">
            {navLinks.map((entry) => (
                <li>
                    <a href={entry.href} {...entry.attrs} aria-current={entry.isCurrent ? 'page' : undefined}>
                        {entry.label}
                    </a>
                </li>
            ))}
        </ul>
    )}
</div>

<style>
    .tr-title-bar {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        min-width: 0;
    }

    .tr-site-title {
        display: flex;
        flex: none;
        align-items: center;
        color: var(--tr-heading);
        text-decoration: none;
    }

    .tr-lockup {
        display: block;
        width: calc(254.34px * 0.75);
        height: 30px;
    }

    .tr-mark {
        display: none;
        width: 48px;
        height: 30px;
    }

    :global(:root[data-theme='light']) .tr-on-dark,
    :global(:root:not([data-theme='light'])) .tr-on-light {
        display: none !important;
    }

    .tr-nav-links {
        display: flex;
        gap: 0.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
        white-space: nowrap;
    }

    .tr-nav-links a {
        display: block;
        padding: 0.375rem 0.75rem;
        border-radius: 999px;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--tr-muted);
        text-decoration: none;
        transition: color 150ms ease, background-color 150ms ease;
    }

    .tr-nav-links a:hover {
        background-color: var(--tr-hover);
        color: var(--tr-heading);
    }

    .tr-nav-links a[aria-current='page'] {
        background-color: var(--tr-raised);
        color: var(--tr-heading);
    }

    /* Narrow screens: the mark alone. The sidebar menu holds the same links. */
    @media (max-width: 30rem) {
        .tr-lockup,
        .tr-nav-links {
            display: none;
        }

        .tr-mark {
            display: block;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .tr-nav-links a {
            transition: none;
        }
    }
</style>
