---
/*
 * The Telesphorepo lockup (the ticket mark and the lettered wordmark) and the header links from
 * starlight-utils. This replaces the starlight-utils SiteTitle override, so it also renders the
 * leading nav links that the starlight-utils route middleware puts in Astro.locals.starlightUtils.navLinks.
 * Below 30rem the header shows only the mark.
 */
import Mark from '../../assets/logo-mark.svg';
import Wordmark from '../../assets/logo-wordmark.svg';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const navLinks = Astro.locals.starlightUtils?.navLinks ?? [];
---

<div class="tr-title-bar">
    <a href={siteTitleHref} class="tr-site-title" translate="no" aria-label={siteTitle}>
        <Wordmark class="tr-lockup" width={150} height={22} aria-hidden="true"/>
        <Mark class="tr-mark" width={30} height={30} aria-hidden="true"/>
    </a>
    {navLinks.length > 0 && (
        <ul class="tr-nav-links">
            {navLinks.map((entry) => (
                <li>
                    <a href={entry.href} {...entry.attrs} aria-current={entry.isCurrent ? 'page' : undefined}>
                        {entry.label}
                    </a>
                </li>
            ))}
        </ul>
    )}
</div>

<style>
    .tr-title-bar {
        display: flex;
        align-items: center;
        gap: 2rem;
        min-width: 0;
    }

    .tr-site-title {
        display: flex;
        flex: none;
        align-items: center;
        color: var(--tr-heading);
        text-decoration: none;
    }

    .tr-lockup {
        display: block;
        width: 150px;
        height: auto;
    }

    .tr-mark {
        display: none;
        width: 30px;
        height: 30px;
    }

    .tr-nav-links {
        display: flex;
        gap: 1.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
        white-space: nowrap;
    }

    .tr-nav-links a {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--tr-muted);
        text-decoration: none;
        transition: color 150ms ease;
    }

    .tr-nav-links a:hover,
    .tr-nav-links a[aria-current='page'] {
        color: var(--tr-heading);
    }

    .tr-nav-links a[aria-current='page'] {
        text-decoration: underline;
        text-decoration-color: var(--tr-accent);
        text-decoration-thickness: 2px;
        text-underline-offset: 0.45em;
    }

    /* Narrow screens: the mark alone. The sidebar menu holds the same links. */
    @media (max-width: 30rem) {
        .tr-lockup,
        .tr-nav-links {
            display: none;
        }

        .tr-mark {
            display: block;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .tr-nav-links a {
            transition: none;
        }
    }
</style>
