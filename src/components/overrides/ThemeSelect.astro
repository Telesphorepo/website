---
/*
 * Replaces Starlight's native <select> with a button and a listbox panel: Auto, Dark and Light.
 * It keeps Starlight's contract: the "starlight-theme" localStorage key with the values '' (auto),
 * 'dark' and 'light', the data-theme attribute on <html>, auto mode that follows
 * prefers-color-scheme, and StarlightThemeProvider.updatePickers(), which swaps the icon
 * (svg.label-icon) in every picker. Dark is the default: a missing key means 'dark'
 * (a head script in astro.config.mjs stores it on the first visit).
 */
import { Icon } from '@astrojs/starlight/components';

const id = `tr-theme-${Math.random().toString(36).slice(2, 8)}`;
const options = [
    { value: 'auto', icon: 'laptop', label: Astro.locals.t('themeSelect.auto') },
    { value: 'dark', icon: 'moon', label: Astro.locals.t('themeSelect.dark') },
    { value: 'light', icon: 'sun', label: Astro.locals.t('themeSelect.light') },
] as const;
---

<starlight-theme-select>
    <span id={`${id}-label`} class="sr-only">{Astro.locals.t('themeSelect.accessibleLabel')}</span>
    <button
        type="button"
        class="trigger"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls={`${id}-list`}
        aria-labelledby={`${id}-label ${id}-value`}
    >
        <Icon name="moon" class="label-icon" />
        <span id={`${id}-value`} class="value">{options[1].label}</span>
        <Icon name="down-caret" class="caret" />
    </button>
    <ul id={`${id}-list`} class="panel" role="listbox" popover="auto" tabindex="-1" aria-labelledby={`${id}-label`}>
        {
            options.map((option) => (
                <li
                    role="option"
                    tabindex="-1"
                    data-value={option.value}
                    data-label={option.label}
                    aria-selected={option.value === 'dark' ? 'true' : 'false'}
                >
                    <Icon name={option.icon} class="option-icon" />
                    <span>{option.label}</span>
                </li>
            ))
        }
    </ul>
</starlight-theme-select>

{/* Inlined so that the icon and the label show the stored theme before the first paint. */}
<script is:inline>
    (function () {
        var theme = 'dark';
        try {
            var stored = localStorage.getItem('starlight-theme');
            if (stored !== null) theme = stored || 'auto';
        } catch (e) {}
        StarlightThemeProvider.updatePickers(theme);
        document.querySelectorAll('starlight-theme-select').forEach(function (picker) {
            var option = picker.querySelector('[data-value="' + theme + '"]');
            var value = picker.querySelector('.value');
            if (option && value) value.textContent = option.dataset.label;
        });
    })();
</script>

<script>
    type Theme = 'auto' | 'dark' | 'light';

    declare const StarlightThemeProvider: { updatePickers(theme?: Theme): void };

    /** Key in `localStorage` that Starlight stores the theme under. */
    const storageKey = 'starlight-theme';

    const parseTheme = (theme: unknown): Theme =>
        theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

    function loadTheme(): Theme {
        try {
            const stored = localStorage.getItem(storageKey);
            return stored === null ? 'dark' : parseTheme(stored);
        } catch {
            return 'dark';
        }
    }

    function storeTheme(theme: Theme): void {
        try {
            localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
        } catch {
            // Storage is blocked: the choice lasts until the page closes.
        }
    }

    const getPreferredColorScheme = (): Theme =>
        matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

    /** Apply a theme to the page and show it in every picker. */
    function onThemeChange(theme: Theme): void {
        StarlightThemeProvider.updatePickers(theme);
        document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
        storeTheme(theme);
        document.querySelectorAll<TrThemeSelect>('starlight-theme-select').forEach((picker) => {
            picker.show?.(theme);
        });
    }

    matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
        if (loadTheme() === 'auto') onThemeChange('auto');
    });

    class TrThemeSelect extends HTMLElement {
        trigger = this.querySelector<HTMLButtonElement>('.trigger')!;
        panel = this.querySelector<HTMLElement>('.panel')!;
        options = [...this.querySelectorAll<HTMLElement>('[role="option"]')];

        constructor() {
            super();
            this.show(loadTheme());
            onThemeChange(loadTheme());

            this.trigger.addEventListener('click', () => {
                if (this.isOpen()) this.close(true);
                else this.open('selected');
            });
            this.trigger.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                    e.preventDefault();
                    this.open(e.key === 'ArrowUp' ? 'last' : 'selected');
                }
            });
            this.panel.addEventListener('keydown', (e) => this.onKey(e));
            this.panel.addEventListener('click', (e) => {
                const option = (e.target as Element).closest<HTMLElement>('[role="option"]');
                if (option) this.choose(option);
            });
            this.panel.addEventListener('toggle', (e) => {
                const open = (e as ToggleEvent).newState === 'open';
                this.trigger.setAttribute('aria-expanded', String(open));
            });
            // A light dismiss (a click outside) or Escape from the browser can hide the panel while
            // it holds focus. Give focus back to the trigger only if it would otherwise be lost.
            this.panel.addEventListener('beforetoggle', (e) => {
                if ((e as ToggleEvent).newState !== 'closed') return;
                if (!this.panel.contains(document.activeElement)) return;
                requestAnimationFrame(() => {
                    if (!document.activeElement || document.activeElement === document.body) {
                        this.trigger.focus();
                    }
                });
            });
            addEventListener('resize', () => this.close(false));
            addEventListener('scroll', () => this.close(false), { capture: true, passive: true });
        }

        /** Show a theme as the current choice: label and selected option. */
        show(theme: Theme): void {
            for (const option of this.options) {
                const selected = option.dataset.value === theme;
                option.setAttribute('aria-selected', String(selected));
                if (selected) this.querySelector('.value')!.textContent = option.dataset.label ?? '';
            }
        }

        isOpen(): boolean {
            return this.panel.matches(':popover-open');
        }

        open(focus: 'selected' | 'last'): void {
            if (!this.isOpen()) {
                this.panel.showPopover();
                this.place();
            }
            const selected = this.options.find((o) => o.getAttribute('aria-selected') === 'true');
            const target = focus === 'last' ? this.options.at(-1) : selected ?? this.options[0];
            target?.focus({ preventScroll: true });
        }

        close(returnFocus: boolean): void {
            if (!this.isOpen()) return;
            this.panel.hidePopover();
            if (returnFocus) this.trigger.focus();
        }

        /** Place the panel under the trigger, or over it when there is no room below. */
        place(): void {
            const gap = 6;
            const edge = 8;
            const trigger = this.trigger.getBoundingClientRect();
            const width = this.panel.offsetWidth;
            const height = this.panel.offsetHeight;
            const below = trigger.bottom + gap + height <= innerHeight - edge;
            const top = below ? trigger.bottom + gap : Math.max(edge, trigger.top - gap - height);
            const left = Math.min(
                Math.max(edge, trigger.right - width),
                document.documentElement.clientWidth - width - edge
            );
            this.panel.style.top = `${top}px`;
            this.panel.style.left = `${left}px`;
            this.panel.dataset.side = below ? 'below' : 'above';
        }

        choose(option: HTMLElement): void {
            onThemeChange(parseTheme(option.dataset.value));
            this.close(true);
        }

        onKey(e: KeyboardEvent): void {
            const index = this.options.indexOf(document.activeElement as HTMLElement);
            const last = this.options.length - 1;
            let next = -1;
            switch (e.key) {
                case 'ArrowDown':
                    next = Math.min(index + 1, last);
                    break;
                case 'ArrowUp':
                    next = index === -1 ? last : Math.max(index - 1, 0);
                    break;
                case 'Home':
                    next = 0;
                    break;
                case 'End':
                    next = last;
                    break;
                case 'Enter':
                case ' ':
                    e.preventDefault();
                    if (index !== -1) this.choose(this.options[index]!);
                    return;
                case 'Escape':
                case 'Tab':
                    e.preventDefault();
                    this.close(true);
                    return;
                default:
                    return;
            }
            e.preventDefault();
            this.options[next]?.focus({ preventScroll: true });
        }
    }

    customElements.define('starlight-theme-select', TrThemeSelect);
</script>

<style>
    starlight-theme-select {
        display: block;
    }

    /* The trigger reads like the other header controls: muted text, the heading color on hover. */
    .trigger {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        margin-inline: -0.5rem;
        padding: 0.5rem;
        border: 0;
        border-radius: 6px;
        background-color: transparent;
        color: var(--tr-muted);
        font: inherit;
        font-size: var(--sl-text-sm);
        font-weight: 500;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
        transition: color 150ms ease, background-color 150ms ease;
    }

    .trigger:hover,
    .trigger[aria-expanded='true'] {
        background-color: var(--tr-surface);
        color: var(--tr-heading);
    }

    .label-icon {
        font-size: 0.875rem;
    }

    .caret {
        font-size: 1rem;
        transition: transform 150ms ease;
    }

    .trigger[aria-expanded='true'] .caret {
        transform: rotate(180deg);
    }

    /* The panel: in the top layer, placed by the script next to the trigger. */
    .panel {
        position: fixed;
        inset: auto;
        min-width: 9rem;
        margin: 0;
        padding: 0.25rem;
        border: 1px solid var(--tr-line);
        border-radius: 10px;
        background-color: var(--tr-surface);
        box-shadow: 0 12px 28px -12px rgb(0 0 0 / 0.45);
        color: var(--tr-body);
        font-size: var(--sl-text-sm);
        list-style: none;
    }

    .panel[popover]:popover-open {
        animation: tr-theme-panel-in 120ms ease-out;
    }

    .panel[data-side='above']:popover-open {
        animation-name: tr-theme-panel-in-above;
    }

    @keyframes tr-theme-panel-in {
        from {
            opacity: 0;
            transform: translateY(-4px);
        }
    }

    @keyframes tr-theme-panel-in-above {
        from {
            opacity: 0;
            transform: translateY(4px);
        }
    }

    /* An option: hover fills the row, and the current theme keeps a fill. */
    [role='option'] {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        border-radius: 4px;
        color: var(--tr-muted);
        white-space: nowrap;
        cursor: pointer;
        user-select: none;
    }

    [role='option']:hover,
    [role='option']:focus {
        background-color: var(--tr-hover);
        color: var(--tr-heading);
    }

    [role='option']:focus-visible {
        outline-offset: -2px;
    }

    [role='option'][aria-selected='true'] {
        background-color: var(--tr-raised);
        color: var(--tr-heading);
        font-weight: 600;
    }

    .option-icon {
        font-size: 0.875rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .trigger,
        .caret {
            transition: none;
        }

        .panel[popover]:popover-open {
            animation: none;
        }
    }
</style>
